node_modules/
dist/
dist-daemon/
out/
.turbo/
.DS_Store

# Playwright e2e: keep the *-snapshots/ baselines (committed), drop run output.
test-results/
playwright-report/
apps/desktop/e2e/.artifacts/

# Playwright MCP (agent browser drive) dumps page-*.yml / console logs at repo root.
# Remove run output when the task is done.
.playwright-mcp/

# Local managed Worktree profile
.porcelain-worktree.json

# Personal agent instructions
AGENTS.local.md

# Local env files — the per-repo Expo account (EXPO_TOKEN). An Expo access token is a
# FULL-account credential (publish updates, submit builds, rotate signing keys), so it
# never enters git. Also covers `.envrc`; a tracked template would need `!.env.example`.
.env*

# Marketing screenshots produced by `pnpm shots` — regenerated, not tracked.
marketing/shots/

# Ephemeral agent automation (one-off shot scripts, local harnesses, tmp PNG dumps).
scripts/agent-scratch/

# Generated coverage and test reports
coverage/
.stryker-tmp/
reports/

# TypeScript incremental build cache
*.tsbuildinfo
