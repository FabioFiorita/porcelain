{
  "plugins": ["typescript"],
  "jsPlugins": ["./architecture/oxlint-plugin.mjs"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "porcelain/no-comments": "error",
    "porcelain/models-are-types": "error",
    "porcelain/bootstrap-constructs-only": "error",
    "porcelain/no-null-in-domain": "error",
    "porcelain/use-case-imports": "error",
    "porcelain/no-schema-parse-in-typed-code": "error",
    "porcelain/operation-class-shape": "error",
    "porcelain/feature-route-shape": "error",
    "porcelain/spec-no-mocking": "error",
    "porcelain/spec-no-skips": "error",
    "porcelain/spec-one-case-per-behaviour": "error",
    "porcelain/spec-behaviour-names": "error",
    "porcelain/spec-asserts": "error",
    "porcelain/spec-imports": "error",
    "porcelain/operation-class-members": "error",
    "porcelain/feature-route-registrations": "error",
    "porcelain/feature-route-handler": "error",
    "porcelain/mcp-tool-handler": "error",
    "porcelain/no-schema-parse-aliases": "error",
    "porcelain/no-loose-equality-in-domain": "error",
    "porcelain/no-node-globals": "error",
    "porcelain/no-disable-directives": "error",
    "porcelain/no-void-statement": "error",
    "porcelain/adapters-never-import-services": "error",
    "porcelain/rules-are-pure": "error",
    "porcelain/static-imports": "error",
    "porcelain/kernel-is-types": "error",
    "porcelain/models-file-shape": "error",
    "porcelain/no-inline-execute-types": "error",
    "porcelain/one-clock": "error",
    "porcelain/no-undefined-union-result": "error",
    "porcelain/signals-are-passed": "error",
    "porcelain/imports-by-path": "error",
    "porcelain/port-shape": "error",
    "porcelain/no-exported-constants": "error",
    "porcelain/no-number-outside-limits": "error",
    "porcelain/naming": "error",
    "porcelain/implementation-name": "error",
    "porcelain/bootstrap-starts-nothing": "error",
    "porcelain/fakes-store": "error",
    "porcelain/scope-shape": "error",
    "porcelain/no-interface-in-runtime": "error",
    "porcelain/timers-in-runtime": "error",
    "porcelain/fixture-imports": "error",
    "porcelain/events-after-lane": "error",
    "porcelain/use-case-input-is-contract": "error",
    "porcelain/failure-in-service": "error",
    "porcelain/cross-domain-through-use-cases": "error",
    "porcelain/use-case-computes": "error",
    "porcelain/events-from-use-cases": "error",
    "porcelain/no-nested-lane": "error",
    "porcelain/lane-only-with-store": "error",
    "porcelain/lane-after-check": "error",
    "porcelain/interfaces-only-in-ports": "error",
    "porcelain/adapters-report-facts": "error",
    "porcelain/root-scripts-import-no-package": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/consistent-type-imports": "error"
  },
  "overrides": [
    {
      "files": ["architecture/*.mjs", "architecture/*.cjs"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
