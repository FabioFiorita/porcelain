      "types": []
    },
    "include": [
      "src/**/*.ts",
      "spec/**/*.ts",
      "../../architecture/platform/domain-globals.d.ts"
    ]
  },
  "packages/git/tsconfig.json": {
    "extends": "../../tsconfig.json",
