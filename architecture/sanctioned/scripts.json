{
  "package.json": {
    "typecheck:server": "tsc --noEmit && pnpm --filter '@porcelain/server...' -r typecheck",
    "lint:server": "node scripts/server-style.ts lint",
    "format:server:check": "node scripts/server-style.ts format",
    "arch:check": "node scripts/architecture.ts check",
    "probes": "node scripts/probes.ts",
    "test": "vitest run",
    "db:check": "pnpm --filter @porcelain/storage db:check",
    "prepare": "lefthook install --reset-hooks-path",
    "typecheck:web": "pnpm --filter @porcelain/web typecheck",
    "lint:web": "oxlint apps/web/src apps/web/spec apps/web/vite.config.ts",
    "format:web:check": "oxfmt --check apps/web/src apps/web/spec apps/web/vite.config.ts",
    "arch:web": "node scripts/web-architecture.ts",
    "probes:web": "node scripts/web-probes.ts",
    "verify:web": "node .agents/skills/web-verify/scripts/browser.ts"
  },
  "apps/server/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "apps/web/package.json": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "packages/access/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/agents/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/changes/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/contracts/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/files/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/git/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/git-actions/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/kernel/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/process/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/projects/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/reviews/package.json": {
    "typecheck": "tsc --noEmit"
  },
  "packages/storage/package.json": {
    "typecheck": "tsc --noEmit",
    "db:check": "drizzle-kit check && node scripts/check-migrations.ts"
  }
}
