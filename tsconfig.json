{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingEffectContext": "error",
          "missingLayerContext": "error",
          "missingStarInYieldEffectGen": "error",
          "anyUnknownInErrorContext": "error",
          "classSelfMismatch": "error",
          "promiseInEffectSuccess": "error",
          "overriddenSchemaConstructor": "error",
          "returnEffectInGen": "error",
          "unsafeEffectTypeAssertion": "error",
          "globalErrorInEffectFailure": "error",
          "globalErrorInEffectCatch": "error"
        }
      }
    ]
  },
  "include": [
    "vitest.config.ts",
    "vitest.integration.config.ts",
    ".agents/skills/spec/**/*.ts",
    "scripts/**/*.ts",
    ".agents/skills/server-verify/scripts/**/*.ts",
    ".agents/skills/verify-core/**/*.ts",
    ".agents/skills/web-verify/scripts/**/*.ts",
    ".agents/skills/desktop-verify/scripts/**/*.ts",
    ".agents/skills/mobile-verify/scripts/**/*.ts",
    "apps/mobile/spec/**/*.ts",
    "architecture/*.ts",
    "apps/server/src/adapters/files/node-opendir.d.ts",
    "apps/mobile/app.config.ts"
  ]
}
