{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "globalEnv": ["CI"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{spec,test,e2e,integration}.{ts,tsx}",
        "!spec/{integration,e2e}/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@porcelain/server#test:integration": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.integration.config.ts"]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false
    },
    "@porcelain/desktop#test:e2e": {
      "dependsOn": ["transit", "@porcelain/web#transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/collect-desktop-crashes.sh"
      ],
      "cache": false
    },
    "//#typecheck": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#lint:server": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#lint:web": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#format:server:check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#format:web:check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#arch:check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#mobile:react-compiler": {
      "inputs": [
        "apps/mobile/src/**",
        "apps/mobile/babel.config.js",
        "apps/mobile/package.json",
        "scripts/react-compiler.ts",
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    "//#test:rules": {
      "inputs": [
        "architecture/**",
        "scripts/style.ts",
        "scripts/architecture.ts",
        "scripts/feature-maps.ts",
        "scripts/feature-api-routes.ts",
        "scripts/react-compiler.ts",
        ".oxlintrc.json",
        ".oxfmtrc.json",
        "tsconfig.json",
        "apps/web/tsconfig.json",
        "apps/web/tsconfig.node.json",
        "apps/server/tsconfig.json",
        "packages/{access,changes,files,git-actions,kernel,projects,reviews}/tsconfig.json",
        "apps/mobile/babel.config.js",
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        ".*/*/package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ".github/workflows/ci.yml",
        "turbo.json",
        "apps/server/spec/kit/route-coverage.ts",
        "apps/server/src/ports/lane-options.ts",
        "apps/server/src/ports/worktree-consistency-probe.ts",
        "apps/server/src/runtime/errors/application-closed-error.ts",
        "apps/server/src/runtime/lane-admission.ts",
        "apps/server/src/runtime/lanes.ts",
        "packages/access/src/errors/**/*.ts",
        "packages/agents/src/**/*.ts",
        "packages/changes/src/errors/**/*.ts",
        "packages/client/src/features/access/ports/connection-factory.ts",
        "packages/client/src/features/access/ports/environment-storage.ts",
        "packages/client/src/features/access/rules/browser-session.ts",
        "packages/client/src/features/access/rules/remotes.ts",
        "packages/client/src/features/access/store.ts",
        "packages/client/src/features/access/store/remote-connections.ts",
        "packages/client/src/features/access/store/session.ts",
        "packages/client/src/features/git-actions/ports/**/*.ts",
        "packages/client/src/features/git-actions/store/**/*.ts",
        "packages/client/src/features/live/ports/**/*.ts",
        "packages/client/src/features/persistence/**/*.ts",
        "packages/client/src/features/projects/ports/project-selection-storage.ts",
        "packages/client/src/features/projects/store.ts",
        "packages/client/src/shared/api/connection-error.ts",
        "packages/client/src/shared/api/connection.ts",
        "packages/client/src/shared/api/read-subscriptions.ts",
        "packages/client/src/shared/api/stale-answer.ts",
        "packages/client/src/shared/api/transport.ts",
        "packages/client/src/shared/api/write-queue.ts",
        "packages/contracts/src/access/**/*.ts",
        "packages/contracts/src/changes/**/*.ts",
        "packages/contracts/src/files/**/*.ts",
        "packages/contracts/src/git-actions/**/*.ts",
        "packages/contracts/src/projects/**/*.ts",
        "packages/contracts/src/reviews/**/*.ts",
        "packages/contracts/src/shared/**/*.ts",
        "packages/effects/src/worktree-lease.ts",
        "packages/files/src/errors/**/*.ts",
        "packages/git-actions/src/errors/**/*.ts",
        "packages/git/src/shared/errors/git-action-rejected-error.ts",
        "packages/git/src/shared/errors/git-command-error.ts",
        "packages/git/src/shared/errors/git-error.ts",
        "packages/git/src/shared/errors/git-filesystem-error.ts",
        "packages/git/src/shared/errors/git-io-failure.ts",
        "packages/git/src/shared/errors/git-output-limit-error.ts",
        "packages/git/src/shared/errors/git-timeout-error.ts",
        "packages/git/src/shared/errors/history-snapshot-unavailable-error.ts",
        "packages/git/src/shared/errors/history-worktree-unavailable-error.ts",
        "packages/git/src/shared/errors/index.ts",
        "packages/git/src/shared/errors/inspection-limit-error.ts",
        "packages/git/src/shared/errors/invalid-git-diff-error.ts",
        "packages/git/src/shared/errors/invalid-git-status-error.ts",
        "packages/git/src/shared/errors/invalid-history-request-error.ts",
        "packages/git/src/shared/errors/is-missing.ts",
        "packages/git/src/shared/errors/is-repository-unavailable.ts",
        "packages/git/src/shared/errors/read-limit-exceeded-error.ts",
        "packages/git/src/shared/errors/repository-identity-mismatch-error.ts",
        "packages/git/src/shared/errors/repository-unavailable-reason.ts",
        "packages/git/src/shared/errors/unsupported-filesystem-identity-error.ts",
        "packages/git/src/shared/errors/unsupported-git-filters-error.ts",
        "packages/git/src/shared/errors/unsupported-history-data-error.ts",
        "packages/git/src/shared/errors/unsupported-path-encoding-error.ts",
        "packages/git/src/shared/errors/unsupported-repository-error.ts",
        "packages/kernel/src/**/*.ts",
        "packages/process/**/*.ts",
        "packages/projects/src/errors/**/*.ts",
        "packages/projects/src/models/check-worktree.ts",
        "packages/projects/src/models/index.ts",
        "packages/projects/src/models/list-project-worktrees.ts",
        "packages/projects/src/models/listed-worktree.ts",
        "packages/projects/src/models/project-folder.ts",
        "packages/projects/src/models/project-repository.ts",
        "packages/projects/src/models/project-unavailable-reason.ts",
        "packages/projects/src/models/project-worktrees.ts",
        "packages/projects/src/models/project.ts",
        "packages/projects/src/models/worktree-catalog.ts",
        "packages/projects/src/models/worktree-listing.ts",
        "packages/projects/src/models/worktree-presence.ts",
        "packages/reviews/src/errors/**/*.ts",
        "packages/reviews/src/models/**/*.ts",
        "packages/reviews/src/ports/branch-review-reader.ts",
        "packages/reviews/src/ports/comment-seen-store.ts",
        "packages/reviews/src/ports/comment-store.ts",
        "packages/reviews/src/ports/create-comment-thread-options.ts",
        "packages/reviews/src/ports/edit-comment-message-options.ts",
        "packages/reviews/src/ports/github-account-store.ts",
        "packages/reviews/src/ports/github-reader.ts",
        "packages/reviews/src/ports/proof-limits.ts",
        "packages/reviews/src/ports/read-proof-file-options.ts",
        "packages/reviews/src/ports/reply-to-comment-options.ts",
        "packages/reviews/src/ports/resolve-published-review-options.ts",
        "packages/reviews/src/ports/review-archiver.ts",
        "packages/reviews/src/ports/review-code-reader.ts",
        "packages/reviews/src/ports/review-commit-pinner.ts",
        "packages/reviews/src/ports/review-store.ts",
        "packages/reviews/src/ports/reviewed-file-store.ts",
        "packages/reviews/src/ports/reviewed-layer-store.ts",
        "packages/reviews/src/ports/set-reviewed-files-options.ts",
        "packages/reviews/src/ports/signature-source.ts",
        "packages/reviews/src/rules/comment-threads.ts",
        "packages/reviews/src/rules/github-account.ts",
        "packages/reviews/src/rules/pull-request.ts",
        "packages/reviews/src/rules/resolve-review.ts",
        "packages/reviews/src/rules/review-comparison.ts",
        "packages/reviews/src/rules/review-diagnostics.ts",
        "packages/reviews/src/rules/review-digests.ts",
        "packages/reviews/src/rules/review-draft.ts",
        "packages/reviews/src/rules/review-evidence.ts",
        "packages/reviews/src/rules/review-proof.ts",
        "packages/reviews/src/rules/review-publication.ts",
        "packages/reviews/src/rules/reviewed-marks.ts",
        "packages/reviews/src/rules/summary-style.ts",
        "packages/reviews/src/rules/worktree-statuses.ts",
        "packages/reviews/src/services/**/*.ts",
        "!packages/**/*.spec.ts"
      ]
    },
    "//#features:check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#knip": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "build": {
      "dependsOn": ["transit"]
    },
    "db:check": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "//#build:marketing": {
      "inputs": [
        "apps/marketing/package.json",
        "apps/marketing/astro.config.ts",
        "apps/marketing/tsconfig.json",
        "apps/marketing/src/**",
        "apps/marketing/public/**",
        "packages/client/src/**",
        "packages/contracts/src/**",
        "apps/web/public/icon-512.png",
        "packages/theme/src/**",
        "pnpm-lock.yaml"
      ],
      "outputs": ["apps/marketing/dist/**"]
    },
    "//#build:package": {
      "cache": false,
      "inputs": [
        "apps/server/**",
        "apps/web/**",
        "packages/**",
        "scripts/build-package.ts",
        "scripts/server.ts",
        "scripts/check-package.sh",
        ".github/workflows/**",
        "package.json",
        "tsconfig.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml"
      ],
      "outputs": ["dist-porcelain/**"]
    },
    "@porcelain/client#test:integration": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.integration.config.ts"]
    },
    "//#spec:gaps": {
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false
    },
    "@porcelain/verification#transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "*/scripts/**",
        "verify-core/**",
        "package.json",
        "!**/*.spec.ts"
      ]
    },
    "@porcelain/verification#test:integration": {
      "dependsOn": ["transit", "@porcelain/web#transit"],
      "inputs": [
        "*/scripts/**",
        "verify-core/**",
        "spec/integration/**",
        "$TURBO_ROOT$/vitest.integration.config.ts"
      ]
    }
  },
  "globalDependencies": [
    ".github/workflows/ci.yml",
    "pnpm-workspace.yaml",
    "package.json"
  ]
}
