{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "globalEnv": ["CI"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{spec,test,e2e,integration,perf}.{ts,tsx}",
        "!spec/{integration,e2e,perf}/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@porcelain/server#test:integration": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.integration.config.ts"]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false
    },
    "@porcelain/desktop#test:e2e": {
      "dependsOn": ["transit", "@porcelain/web#transit"],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false
    },
    "//#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#lint:server": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#lint:web": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#format:server:check": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#format:web:check": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#arch:check": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#mobile:react-compiler": {
      "inputs": [
        "apps/mobile/src/**",
        "apps/mobile/babel.config.js",
        "apps/mobile/package.json",
        "scripts/react-compiler.ts",
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    "//#test:rules": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#features:check": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#knip": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "build": {
      "dependsOn": ["transit"]
    },
    "db:check": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "//#build:marketing": {
      "inputs": [
        "apps/marketing/package.json",
        "apps/marketing/astro.config.ts",
        "apps/marketing/tsconfig.json",
        "apps/marketing/src/**",
        "apps/marketing/public/**",
        "docs/readme/walkthrough.png",
        "docs/readme/comments.png",
        "docs/readme/proof.png",
        "apps/web/public/icon-512.png",
        "packages/theme/src/**",
        "pnpm-lock.yaml"
      ],
      "outputs": ["apps/marketing/dist/**"]
    },
    "//#build:package": {
      "cache": false,
      "inputs": [
        "apps/server/**",
        "apps/web/**",
        "packages/**",
        "scripts/build-package.ts",
        "scripts/server.ts",
        "scripts/check-package.sh",
        ".github/workflows/**",
        "package.json",
        "tsconfig.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml"
      ],
      "outputs": ["dist-porcelain/**"]
    },
    "@porcelain/client#test:integration": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.integration.config.ts"]
    },
    "//#spec:gaps": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"],
      "cache": false
    },
    "@porcelain/verification#transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "*/scripts/**",
        "verify-core/**",
        "package.json",
        "!**/*.spec.ts"
      ]
    },
    "@porcelain/verification#test:integration": {
      "dependsOn": ["transit", "@porcelain/web#transit"],
      "inputs": [
        "*/scripts/**",
        "verify-core/**",
        "spec/integration/**",
        "$TURBO_ROOT$/vitest.integration.config.ts"
      ]
    }
  },
  "globalDependencies": [".github/workflows/ci.yml", "pnpm-workspace.yaml"]
}
