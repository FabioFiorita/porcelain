{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "vitest.config.ts",
    "scripts/test-configuration.ts",
    "scripts/run-scoped-tests.ts",
    "scripts/run-turbo.ts",
    ".node-version",
    "pnpm-workspace.yaml",
    "scripts/runtime-fingerprint.ts",
    "playgrounds/**"
  ],
  "globalEnv": ["PORCELAIN_RUNTIME_FINGERPRINT", "PORCELAIN_TEST_SCOPE"],
  "globalPassThroughEnv": [
    "HOME",
    "PATH",
    "TMPDIR",
    "TMP",
    "TEMP",
    "GIT_*",
    "SSH_*",
    "LANG",
    "LC_*",
    "PORCELAIN_PLAYGROUND_INFO",
    "PORCELAIN_PLAYGROUND_DIRECTORY",
    "PORCELAIN_API_TARGET",
    "PORCELAIN_PLAYGROUND_BRIDGE",
    "PORCELAIN_PLAYGROUND_TOKEN_FILE"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage", "^typecheck"],
      "outputs": ["coverage/**"]
    },
    "//#test:tooling": {
      "inputs": [
        "scripts/**",
        "biome.json",
        "doctor.config.json",
        ".husky/pre-commit",
        "package.json",
        "vitest.config.ts",
        "tsconfig.json",
        "apps/**/*.spec.*",
        "packages/**/*.spec.*",
        "apps/server/src/**",
        "apps/server/drizzle/**",
        "packages/git/src/**",
        "packages/contracts/src/**",
        "apps/web/vite.config.ts",
        "apps/web/development/**"
      ],
      "outputs": ["coverage/tooling/**"]
    }
  },
  "cacheDir": ".turbo/cache"
}
