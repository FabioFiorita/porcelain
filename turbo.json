{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "globalEnv": ["CI"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{spec,test,e2e,integration,perf}.{ts,tsx}",
        "!spec/{integration,e2e,perf}/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"]
    },
    "@porcelain/server#test:integration": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/.agents/skills/server-verify/scripts/**",
        "$TURBO_ROOT$/.agents/skills/verify-core/**",
        "$TURBO_ROOT$/.agents/skills/web-verify/scripts/**"
      ]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/workflows/ci.yml"],
      "cache": false
    },
    "@porcelain/desktop#test:e2e": {
      "dependsOn": ["transit", "@porcelain/web#transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/workflows/ci.yml"],
      "cache": false
    },
    "//#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#lint:server": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#lint:web": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#format:server:check": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#format:web:check": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#arch:check": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#test:rules": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#features:check": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "//#knip": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "build": {
      "dependsOn": ["transit"]
    },
    "db:check": {
      "dependsOn": ["transit"],
      "cache": false
    }
  }
}
