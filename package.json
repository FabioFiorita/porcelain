{
  "name": "porcelain",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.20.0 <25 || >=26.8.1 <27"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings . && node scripts/check-conventions.ts",
    "typecheck": "tsc --noEmit && node scripts/run-turbo.ts typecheck",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "test": "vitest run",
    "test:coverage": "node scripts/run-turbo.ts test:coverage test:tooling && node scripts/merge-coverage.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm check:unused && pnpm test:coverage && pnpm test:web:smoke",
    "check:unused": "knip",
    "test:tooling": "node scripts/run-scoped-tests.ts tooling",
    "dev:web": "pnpm --filter @porcelain/web dev",
    "test:web:smoke": "pnpm --filter @porcelain/web test:smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "dependency-cruiser": "18.2.0",
    "fast-check": "4.9.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "knip": "6.34.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "typescript-parser": "npm:typescript@6.0.3",
    "vitest": "5.0.0"
  }
}
