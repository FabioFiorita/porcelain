{
  "name": "porcelain",
  "private": true,
  "description": "Where agent work becomes trusted work.",
  "author": "Fabio Fiorita <fabiolfp@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioFiorita/porcelain.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check . && node scripts/lint-control-recipes.mjs && node scripts/lint-escapes.mjs && node scripts/lint-audit.mjs && node scripts/lint-shadcn-heuristics.mjs && node scripts/lint-comments.mjs && node scripts/lint-render-refs.mjs && node scripts/lint-ratchets.mjs && node scripts/lint-doc-budget.mjs && pnpm agents:check && pnpm lint:knip",
    "lint:fix": "biome check --write .",
    "lint:ratchets": "node scripts/lint-ratchets.mjs && node scripts/lint-doc-budget.mjs",
    "lint:audit": "node scripts/lint-audit.mjs",
    "lint:controls": "node scripts/lint-control-recipes.mjs",
    "lint:escapes": "node scripts/lint-escapes.mjs",
    "lint:shadcn": "node scripts/lint-shadcn-heuristics.mjs",
    "lint:knip": "knip --include files,dependencies,unlisted,binaries,duplicates,exports,types --no-config-hints",
    "agents:check": "node scripts/sync-agent-foundations.mjs",
    "agents:sync": "node scripts/sync-agent-foundations.mjs --write",
    "agents:doctor": "node scripts/agent-doctor.mjs",
    "agents:setup": "pnpm agents:sync && husky && pnpm agents:doctor",
    "worktree": "node scripts/worktree.mjs",
    "worktree:create": "node scripts/worktree.mjs create",
    "worktree:list": "node scripts/worktree.mjs list",
    "worktree:pr": "node scripts/worktree.mjs pr",
    "worktree:adopt": "node scripts/worktree.mjs adopt",
    "worktree:remove": "node scripts/worktree.mjs remove",
    "worktree:cleanup": "node scripts/worktree.mjs cleanup",
    "typecheck": "pnpm --dir apps/desktop typecheck && pnpm typecheck:mobile",
    "typecheck:node": "pnpm --dir apps/desktop typecheck:node",
    "typecheck:web": "pnpm --dir apps/desktop typecheck:web",
    "typecheck:e2e": "pnpm --dir apps/desktop typecheck:e2e",
    "typecheck:mobile": "pnpm --dir apps/mobile typecheck",
    "mobile:start": "pnpm --dir apps/mobile start",
    "mobile:start:mcp": "pnpm --dir apps/mobile start:mcp",
    "mobile:dev:remote": "node scripts/mobile-remote-dev.mjs",
    "mobile:fixture": "node scripts/mobile-fixture-daemon.mjs",
    "mobile:sim:build": "pnpm --dir apps/mobile sim:build",
    "mobile:sim:install": "pnpm --dir apps/mobile sim:install",
    "mobile:dev:device": "pnpm --dir apps/mobile dev:device",
    "mobile:dev:build": "pnpm --dir apps/mobile dev:build",
    "start": "pnpm --dir apps/desktop start",
    "dev": "pnpm --dir apps/desktop dev",
    "dev:daemon": "node scripts/dev-daemon.mjs",
    "dev:env": "node scripts/dev-env.mjs",
    "porcelain": "node scripts/porcelain-dev.mjs",
    "build": "pnpm typecheck:mobile && pnpm --dir apps/desktop build",
    "test": "pnpm --dir apps/desktop test",
    "test:watch": "pnpm --dir apps/desktop test:watch",
    "test:e2e": "pnpm --dir apps/desktop test:e2e",
    "test:e2e:prebuilt": "pnpm --dir apps/desktop test:e2e:prebuilt",
    "test:e2e:update": "pnpm --dir apps/desktop test:e2e:update",
    "test:e2e:native": "pnpm --dir apps/desktop test:e2e:native",
    "test:e2e:native:prebuilt": "pnpm --dir apps/desktop test:e2e:native:prebuilt",
    "test:e2e:native:update": "pnpm --dir apps/desktop test:e2e:native:update",
    "shots": "pnpm --dir apps/desktop shots",
    "dist": "pnpm --dir apps/desktop dist",
    "package:mac": "pnpm --dir apps/desktop package:mac",
    "daemon:dist": "node scripts/build-daemon-dist.mjs",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$PWD\" ] && husky || true",
    "release": "node scripts/release-cut.mjs",
    "release:prebuilt": "pnpm --dir apps/desktop release:prebuilt",
    "release:cut": "node scripts/release-cut.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:fuse-smoke": "node scripts/release-fuse-smoke.mjs",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -r 1 --pkg apps/desktop/package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "typescript": "^6.0.3"
  }
}
