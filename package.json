{
  "name": "porcelain",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit && pnpm --filter '@porcelain/server...' -r typecheck",
    "lint:server": "node scripts/style.ts lint server",
    "lint:web": "node scripts/style.ts lint web",
    "format:server:check": "node scripts/style.ts format server",
    "format:web:check": "node scripts/style.ts format web",
    "arch:check": "node scripts/architecture.ts check",
    "test": "vitest run --project !@porcelain/client-integration --project !@porcelain/server-integration --project !@porcelain/server-perf --project !@porcelain/mobile-e2e*",
    "test:integration": "turbo run test:integration --concurrency=1",
    "db:check": "pnpm --filter @porcelain/storage db:check",
    "dev": "node scripts/dev.ts",
    "dev:server": "node apps/server/spec/kit/sandbox.ts",
    "dev:web": "pnpm --filter @porcelain/web dev",
    "serve": "node scripts/serve.ts",
    "build:package": "node scripts/build-package.ts",
    "prepare": "lefthook install --reset-hooks-path && effect-tsgo patch --typescript",
    "check": "turbo run typecheck lint:server lint:web format:server:check format:web:check arch:check --output-logs=errors-only --continue --concurrency=2",
    "desktop:build": "node scripts/build-desktop.ts",
    "desktop:install": "node scripts/install-desktop.ts",
    "dev:mobile": "pnpm --filter @porcelain/mobile dev"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@effect/tsgo": "0.48.0",
    "@effect/vitest": "4.0.0",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@porcelain/contracts": "workspace:*",
    "@porcelain/desktop": "workspace:*",
    "@shadcn/lint": "0.2.0",
    "@tanstack/router-generator": "1.167.34",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.4.0",
    "effect": "4.0.0",
    "esbuild": "0.28.2",
    "knip": "6.39.0",
    "lefthook": "2.1.14",
    "oxc-parser": "0.148.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright": "1.63.0",
    "turbo": "2.11.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "pnpm@12.3.4"
}
