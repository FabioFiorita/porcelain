{
  "name": "porcelain",
  "version": "0.81.0",
  "description": "Review coding agents’ changes from a browser, Mac or phone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioFiorita/porcelain.git"
  },
  "homepage": "https://github.com/FabioFiorita/porcelain",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:server": "node scripts/style.ts lint server",
    "lint:web": "node scripts/style.ts lint web",
    "format:server:check": "node scripts/style.ts format server",
    "format:web:check": "node scripts/style.ts format web",
    "arch:check": "node scripts/architecture.ts check",
    "mobile:react-compiler": "node scripts/react-compiler.ts",
    "test": "vitest run",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "db:check": "pnpm --filter @porcelain/storage db:check",
    "dev": "node scripts/dev.ts",
    "dev:walkthrough": "node .agents/skills/web-verify/scripts/cli.ts start --walkthrough-sample",
    "dev:marketing": "pnpm --filter @porcelain/marketing dev",
    "build:package": "node scripts/build-package.ts",
    "build:marketing": "pnpm --filter @porcelain/marketing build",
    "prepare": "lefthook install --reset-hooks-path && effect-tsgo patch --typescript",
    "check": "turbo run typecheck test lint:server lint:web format:server:check format:web:check arch:check mobile:react-compiler test:rules knip features:check build:marketing --output-logs=errors-only --continue --concurrency=100%",
    "test:rules": "node architecture/rule-tests.mjs",
    "features:check": "node scripts/feature-maps.ts",
    "desktop:build": "node scripts/build-desktop.ts",
    "dev:mobile": "pnpm --filter @porcelain/mobile dev",
    "check:static": "turbo run typecheck lint:server lint:web format:server:check format:web:check arch:check mobile:react-compiler test:rules knip features:check build:marketing --output-logs=errors-only --continue",
    "check:local": "pnpm check:static --concurrency=2",
    "knip": "knip --config architecture/knip.ts --no-progress"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "0.67.3",
    "@effect/vitest": "4.1.2",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@porcelain/contracts": "workspace:*",
    "@shadcn/lint": "0.2.0",
    "@tanstack/markdown": "0.0.14",
    "@tanstack/router-generator": "1.167.34",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "dependency-cruiser": "18.4.0",
    "effect": "4.1.2",
    "esbuild": "0.28.2",
    "github-slugger": "2.0.0",
    "jscpd": "5.3.3",
    "knip": "6.39.0",
    "lefthook": "2.1.14",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "turbo": "2.11.6",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.20.0 <25 || >=26.13.0 <27"
  },
  "packageManager": "pnpm@12.3.4"
}
