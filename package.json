{
  "name": "porcelain",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.20.0 <25 || >=26.8.1 <27"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm format:check && pnpm lint && pnpm check:react && pnpm typecheck && pnpm check:boundaries && pnpm check:unused && pnpm test:coverage && pnpm test:web:smoke",
    "check:unused": "knip",
    "bench:server": "node scripts/server-bench/run.ts",
    "dev:web": "pnpm --filter @porcelain/web dev",
    "test:web:smoke": "pnpm --filter @porcelain/web test:smoke",
    "check:react": "react-doctor --no-telemetry --no-supply-chain",
    "dev": "node scripts/web-playground.ts",
    "serve": "node scripts/serve.ts",
    "build:package": "node scripts/build-package.ts",
    "test:package": "PORCELAIN_PACKAGE_ACCEPTANCE=1 vitest run scripts/package-acceptance.spec.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.3",
    "@vitest/coverage-istanbul": "5.0.0",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "knip": "6.34.0",
    "react-doctor": "0.9.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
