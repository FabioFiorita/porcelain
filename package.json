{
  "name": "porcelain",
  "private": true,
  "description": "Where agent work becomes trusted work.",
  "author": "Fabio Fiorita <fabiolfp@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioFiorita/porcelain.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check . && node scripts/lint-mobile-nativewind.mjs && node scripts/lint-escapes.mjs && node scripts/lint-audit.mjs && node scripts/lint-eas-triggers.mjs && node scripts/lint-procedure-contracts.mjs && node scripts/lint-skill-commands.mjs && node scripts/sync-versions.mjs --check && pnpm agents:check",
    "versions:sync": "node scripts/sync-versions.mjs",
    "versions:check": "node scripts/sync-versions.mjs --check",
    "lint:fix": "biome check --write .",
    "agents:check": "node scripts/sync-agent-foundations.mjs",
    "agents:sync": "node scripts/sync-agent-foundations.mjs --write",
    "agents:doctor": "node scripts/agent-doctor.mjs",
    "agents:setup": "pnpm agents:sync && husky && pnpm agents:doctor",
    "worktree": "node scripts/worktree.mjs",
    "dev": "pnpm --dir apps/desktop dev",
    "dev:daemon": "node scripts/dev-daemon.mjs",
    "porcelain": "node scripts/porcelain-dev.mjs",
    "build:node": "node scripts/build-node.mjs",
    "build:daemon": "node scripts/build-node.mjs daemon",
    "build:cli": "node scripts/build-node.mjs cli",
    "build:web": "pnpm --dir apps/web build",
    "build": "pnpm --dir apps/mobile typecheck && pnpm --dir apps/desktop build",
    "test": "pnpm --dir apps/desktop test",
    "test:watch": "pnpm --dir apps/desktop test:watch",
    "test:e2e": "pnpm --dir apps/desktop test:e2e",
    "shots": "pnpm --dir apps/desktop shots",
    "dist": "pnpm --dir apps/desktop dist",
    "package:mac": "pnpm --dir apps/desktop package:mac",
    "daemon:dist": "node scripts/build-daemon-dist.mjs",
    "verify": "pnpm lint && pnpm test && pnpm build && pnpm --dir apps/desktop typecheck:e2e",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$PWD\" ] && husky || true",
    "release": "node scripts/release-cut.mjs",
    "release:cut": "node scripts/release-cut.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:prebuilt": "pnpm --dir apps/desktop release:prebuilt",
    "release:fuse-smoke": "node scripts/release-fuse-smoke.mjs",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -r 1 --pkg apps/desktop/package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "0.25.12",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "typescript": "^6.0.3"
  }
}
