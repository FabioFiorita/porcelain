{
  "name": "porcelain",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.20.0 <25 || >=26.8.1 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "typecheck:server": "tsc --noEmit && pnpm --filter '@porcelain/server...' -r typecheck",
    "lint:server": "node scripts/server-style.ts lint",
    "format:server:check": "node scripts/server-style.ts format",
    "arch:check": "node scripts/architecture.ts check",
    "test": "vitest run --passWithNoTests",
    "dev": "pnpm dev:server",
    "dev:server": "node scripts/dev-server.ts",
    "dev:web": "pnpm --filter @porcelain/web dev",
    "serve": "node scripts/serve.ts",
    "build:package": "node scripts/build-package.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.4.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.5.4"
  }
}
