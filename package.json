{
  "name": "porcelain",
  "private": true,
  "description": "Where agent work becomes trusted work.",
  "author": "Fabio Fiorita <fabiolfp@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioFiorita/porcelain.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:one-writer": "node --test scripts/lint-one-writer.test.mjs && node scripts/lint-one-writer.mjs",
    "lint:docs": "node --test scripts/lint-docs.test.mjs && node scripts/lint-docs.mjs",
    "plugin:check": "node --test scripts/plugin-version.test.mjs && node scripts/plugin-version.mjs --check",
    "plugin:lock": "node scripts/plugin-version.mjs",
    "versions:sync": "node scripts/sync-versions.mjs",
    "lint:fix": "biome lint --write .",
    "typecheck": "turbo run check-types",
    "check": "turbo run //#format:check //#lint //#lint:one-writer //#lint:docs //#plugin:check check-types",
    "worktree": "node scripts/worktree.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "dev:daemon": "node scripts/dev-daemon.mjs",
    "dev:env": "node scripts/dev-env.mjs",
    "dev:mobile": "node scripts/mobile-dev.mjs metro",
    "dev:mobile:android": "node scripts/mobile-dev.mjs android",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:pair": "node scripts/dev-pair.mjs",
    "dev:seed": "node scripts/dev-seed.mjs",
    "playground": "node scripts/playground.mjs",
    "build:node": "turbo run build:node --filter=@porcelain/desktop",
    "build:daemon": "turbo run build:daemon --filter=@porcelain/desktop",
    "build:web": "turbo run build:web --filter=@porcelain/desktop",
    "build": "turbo run build --filter=@porcelain/desktop",
    "test": "turbo run test --filter=@porcelain/desktop",
    "test:coverage": "pnpm --dir apps/desktop test:coverage",
    "test:watch": "pnpm --dir apps/desktop test:watch",
    "test:e2e": "pnpm --dir apps/desktop test:e2e",
    "test:e2e:visual": "pnpm --dir apps/desktop test:e2e:visual",
    "test:e2e:smoke": "pnpm --dir apps/desktop test:e2e:smoke",
    "test:e2e:smoke:prebuilt": "pnpm --dir apps/desktop test:e2e:smoke:prebuilt",
    "test:e2e:pairing": "pnpm --dir apps/desktop test:e2e:pairing",
    "test:e2e:pairing:prebuilt": "pnpm --dir apps/desktop test:e2e:pairing:prebuilt",
    "shots": "pnpm --dir apps/desktop shots",
    "dist": "pnpm --dir apps/desktop dist",
    "package:mac": "pnpm --dir apps/desktop package:mac",
    "daemon:dist": "node scripts/build-daemon-dist.mjs",
    "test:scripts": "node --test scripts/dev-daemon.test.mjs scripts/dev-env.test.mjs scripts/dev-electron.test.mjs scripts/dev-seed.test.mjs scripts/mobile-dev.test.mjs scripts/playground.test.mjs scripts/worktree-base.test.mjs",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm turbo run //#test:scripts",
    "release": "node scripts/release-cut.mjs",
    "release:cut": "node scripts/release-cut.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:prebuilt": "pnpm --dir apps/desktop release:prebuilt",
    "release:fuse-smoke": "node scripts/release-fuse-smoke.mjs",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -r 1 --pkg apps/desktop/package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "0.25.12",
    "turbo": "2.10.11",
    "typescript": "^6.0.3"
  }
}
