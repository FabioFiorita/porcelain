{
  "name": "porcelain",
  "private": true,
  "description": "Where agent work becomes trusted work.",
  "author": "Fabio Fiorita <fabiolfp@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioFiorita/porcelain.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check . && pnpm lint:test-shape && pnpm lint:dead-code && pnpm lint:test-orphans && pnpm lint:architecture && pnpm lint:cli && pnpm lint:foundation-ownership && pnpm lint:companion-foundations && pnpm lint:agent-foundations && pnpm lint:launch-cleanup && node scripts/lint-mobile-nativewind.mjs && node scripts/lint-mobile-file-size.mjs && pnpm lint:escapes && node scripts/lint-security-boundaries.mjs && node scripts/lint-eas-triggers.mjs && node scripts/lint-legacy-realtime.mjs && node scripts/lint-legacy-migrations.mjs && node scripts/lint-supporting-regions.test.mjs && node scripts/lint-supporting-regions.mjs && node scripts/lint-pillars.test.mjs && node scripts/lint-pillars.mjs &&node scripts/lint-desktop-boundary.test.mjs && node scripts/lint-desktop-boundary.mjs && pnpm lint:procedure-contracts && node scripts/lint-skill-commands.mjs && pnpm lint:plugin && node scripts/lint-docs.mjs && node scripts/sync-versions.mjs --check && pnpm agents:check",
    "lint:test-shape": "node scripts/quality/test-shape.test.mjs && node scripts/quality/test-shape.mjs --gate",
    "lint:dead-code": "node scripts/quality/dead-code.mjs",
    "lint:test-orphans": "node scripts/lint-test-orphans.test.mjs && node scripts/lint-test-orphans.mjs",
    "lint:test-orphans:baseline": "node scripts/lint-test-orphans.mjs --write-baseline",
    "lint:dead-code:baseline": "node scripts/quality/dead-code.mjs --write-baseline",
    "lint:architecture": "node scripts/lint-architecture.test.mjs && node scripts/lint-architecture.mjs",
    "lint:cli": "node scripts/lint-cli-boundary.test.mjs && node scripts/lint-cli-boundary.mjs",
    "lint:foundation-ownership": "node scripts/lint-foundation-ownership.test.mjs && node scripts/lint-foundation-ownership.mjs",
    "lint:companion-foundations": "node scripts/lint-companion-foundations.test.mjs && node scripts/lint-companion-foundations.mjs",
    "lint:agent-foundations": "node scripts/lint-agent-foundations.test.mjs && node scripts/lint-agent-foundations.mjs",
    "lint:launch-cleanup": "node scripts/lint-launch-cleanup.test.mjs && node scripts/lint-launch-cleanup.mjs",
    "lint:procedure-contracts": "node scripts/lint-procedure-contracts.test.mjs && node scripts/lint-procedure-contracts.mjs",
    "lint:escapes": "node scripts/lint-escapes.test.mjs && node scripts/lint-escapes.mjs",
    "lint:plugin": "node --test scripts/plugin-version.test.mjs && node scripts/plugin-version.mjs --check",
    "plugin:lock": "node scripts/plugin-version.mjs",
    "versions:sync": "node scripts/sync-versions.mjs",
    "versions:check": "node scripts/sync-versions.mjs --check",
    "lint:fix": "biome check --write .",
    "agents:check": "node scripts/sync-agent-foundations.mjs",
    "agents:sync": "node scripts/sync-agent-foundations.mjs --write",
    "agents:doctor": "node scripts/agent-doctor.mjs",
    "agents:setup": "pnpm agents:sync && husky && pnpm agents:doctor",
    "worktree": "node scripts/worktree.mjs",
    "dev": "pnpm --dir apps/desktop dev",
    "dev:daemon": "node scripts/dev-daemon.mjs",
    "dev:pair": "node scripts/dev-pair.mjs",
    "dev:seed": "node scripts/dev-seed.mjs",
    "playground": "node scripts/playground.mjs",
    "porcelain": "node scripts/porcelain-dev.mjs",
    "build:node": "node scripts/build-node.mjs",
    "build:daemon": "node scripts/build-node.mjs daemon",
    "build:cli": "node scripts/build-node.mjs cli",
    "build:web": "pnpm --dir apps/web build",
    "build": "pnpm --dir apps/mobile typecheck && pnpm --dir apps/desktop build",
    "test": "pnpm --dir apps/desktop test",
    "test:coverage": "pnpm --dir apps/desktop test:coverage",
    "quality": "node scripts/quality/report.mjs",
    "quality:baseline": "node scripts/quality/report.mjs --fresh --write-baseline",
    "quality:changed": "node scripts/quality/changed.mjs",
    "mutation": "node scripts/quality/mutate.mjs",
    "test:watch": "pnpm --dir apps/desktop test:watch",
    "test:e2e": "pnpm --dir apps/desktop test:e2e",
    "test:e2e:visual": "pnpm --dir apps/desktop test:e2e:visual",
    "shots": "pnpm --dir apps/desktop shots",
    "dist": "pnpm --dir apps/desktop dist",
    "package:mac": "pnpm --dir apps/desktop package:mac",
    "daemon:dist": "node scripts/build-daemon-dist.mjs",
    "test:scripts": "node --test scripts/dev-env.test.mjs scripts/dev-seed.test.mjs scripts/playground.test.mjs scripts/worktree-base.test.mjs",
    "typecheck:tests": "node scripts/quality/typecheck-tests.mjs",
    "typecheck:tests:ledger": "node scripts/quality/typecheck-tests.mjs --write-ledger",
    "verify": "pnpm lint && pnpm test && pnpm test:scripts && pnpm build && pnpm --dir apps/desktop typecheck:e2e && pnpm typecheck:tests",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$PWD\" ] && husky || true",
    "release": "node scripts/release-cut.mjs",
    "release:cut": "node scripts/release-cut.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:prebuilt": "pnpm --dir apps/desktop release:prebuilt",
    "release:fuse-smoke": "node scripts/release-fuse-smoke.mjs",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -r 1 --pkg apps/desktop/package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "0.25.12",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "typescript": "^6.0.3"
  }
}
