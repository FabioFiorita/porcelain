{
  "name": "@porcelain/server",
  "private": true,
  "type": "module",
  "exports": {
    "./desktop": "./src/bootstrap/desktop.ts",
    "./desktop-settings": "./src/config/desktop-settings.ts",
    "./kit/*": "./spec/kit/*.ts"
  },
  "scripts": {
    "start": "node --input-type=module --eval \"const { runCli } = await import('./src/bootstrap/main.ts'); await runCli();\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project @porcelain/server",
    "test:integration": "vitest run --config ../../vitest.config.ts --project @porcelain/server-integration",
    "test:perf": "vitest run --config ../../vitest.config.ts --project @porcelain/server-perf"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@parcel/watcher": "2.6.0",
    "@porcelain/access": "workspace:*",
    "@porcelain/agents": "workspace:*",
    "@porcelain/changes": "workspace:*",
    "@porcelain/contracts": "workspace:*",
    "@porcelain/effects": "workspace:*",
    "@porcelain/files": "workspace:*",
    "@porcelain/git": "workspace:*",
    "@porcelain/git-actions": "workspace:*",
    "@porcelain/kernel": "workspace:*",
    "@porcelain/process": "workspace:*",
    "@porcelain/projects": "workspace:*",
    "@porcelain/reviews": "workspace:*",
    "@porcelain/storage": "workspace:*",
    "effect": "4.0.0",
    "qrcode-terminal": "0.12.0",
    "trash": "10.1.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/qrcode-terminal": "0.12.2",
    "@types/ws": "8.18.1"
  }
}
