{
  "name": "@porcelain/desktop",
  "private": true,
  "version": "0.47.3",
  "description": "Where agent work becomes trusted work.",
  "main": "./out/main/index.js",
  "author": "Fabio Fiorita <fabiolfp@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioFiorita/porcelain.git"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && pnpm --dir ../.. build:web && electron-vite build && pnpm --dir ../.. build:node",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --project=browser",
    "test:e2e:prebuilt": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --project=browser",
    "test:e2e:update": "pnpm build && PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --project=browser --update-snapshots",
    "test:e2e:native": "pnpm build && PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --project=electron",
    "test:e2e:native:prebuilt": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --project=electron",
    "test:e2e:native:update": "pnpm build && PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --project=electron --update-snapshots",
    "shots": "pnpm build && PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test -c playwright.shots.config.ts",
    "dist": "pnpm build && electron-builder --mac --publish never",
    "package:mac": "electron-builder --mac --publish never",
    "release:prebuilt": "electron-builder --mac --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "trash": "^10.1.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "^2.1.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@playwright/test": "^1.61.0",
    "@porcelain/contracts": "workspace:*",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@trpc/react-query": "^11.17.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^42.6.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "zustand": "^5.0.14"
  }
}
