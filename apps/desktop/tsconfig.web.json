{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../web/src/env.d.ts",
    "src/shared/**/*",
    "../../packages/contracts/src/**/*",
    "../../packages/shared/src/**/*",
    "../daemon/src/**/*",
    "../web/src/**/*",
    "../web/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/test-setup.ts"
  ],
  "exclude": [
    "../../packages/shared/src/**/*.test.ts",
    "../daemon/src/**/*.test.ts",
    "../web/src/**/*.test.ts",
    "../web/src/**/*.test.tsx"
  ],
  "compilerOptions": {
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true,
    "jsx": "react-jsx",
    // baseUrl is retained for the shadcn CLI's alias resolution; TS 6 deprecates it
    // (removed in TS 7), so silence the deprecation until shadcn reads paths directly.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["../web/src/*"],
      "@main/*": ["src/main/*"],
      "@preload/*": ["src/preload/*"],
      "@backend/*": ["../daemon/src/*"],
      "@porcelain/daemon/*": ["../daemon/src/*"],
      "@shared/*": ["../../packages/shared/src/*"],
      "@porcelain/shared/*": ["../../packages/shared/src/*"],
      "@porcelain/contracts": ["../../packages/contracts/src/index.ts"],
      "@porcelain/contracts/*": ["../../packages/contracts/src/*"]
    }
  }
}
