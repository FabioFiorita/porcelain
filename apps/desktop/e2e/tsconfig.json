{
  "compilerOptions": {
    "module": "Preserve",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["../../../packages/shared/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "../playwright.config.ts",
    "../../../packages/shared/src/test-ids.ts",
    "../../../packages/shared/src/canvas-porcelain.ts"
  ]
}
