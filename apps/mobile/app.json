{
  "expo": {
    "name": "Porcelain",
    "slug": "porcelain",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "porcelain",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.fabiofiorita.porcelain",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Porcelain talks to your daemon over the local network or Tailscale, usually at a plain http address.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e14cdaa2-be46-4c7e-8554-432e5f386871"
      }
    },
    "owner": "fabiofiorita",
    "updates": {
      "url": "https://u.expo.dev/e14cdaa2-be46-4c7e-8554-432e5f386871"
    }
  }
}
