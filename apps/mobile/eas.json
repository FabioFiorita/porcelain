{
  "cli": {
    "version": ">=24.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.20.0",
      "pnpm": "12.3.4",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "ios": { "simulator": true },
      "env": { "APP_VARIANT": "development" }
    },
    "preview": {
      "node": "24.20.0",
      "pnpm": "12.3.4",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "preview" }
    },
    "production": {
      "node": "24.20.0",
      "pnpm": "12.3.4",
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6796720233" }
    }
  }
}
