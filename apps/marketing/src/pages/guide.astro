---
import Site from '../layouts/site.astro';
import Command from '../components/command.astro';
import Snippet from '../components/snippet.astro';

const description =
  'How to get the most out of Porcelain: what the walkthrough agent reads, how screenshots reach a step, and five habits that make a repository agent-ready.';
const serve = 'npx @fabiofiorita/porcelain@latest serve';

const headline = [
  { words: ['It', 'explains', 'what', 'is', 'there.'], tone: 'text-muted-foreground' },
  { words: ['Give', 'it', 'more', 'to', 'explain.'], tone: 'text-foreground' },
];

const chapters = [
  ['reads', 'What it reads'],
  ['proof', 'Proof'],
  ['habits', 'Habits'],
  ['instructions', 'Instructions'],
  ['pull-requests', 'Pull requests'],
  ['settings', 'Settings'],
  ['checklist', 'Checklist'],
] as const;

/* What the walkthrough agent is given, in the order it reads it. */
const passes = [
  {
    name: 'First pass',
    note: 'Like a new teammate',
    sources: [
      { label: 'Pull request text', detail: 'Its title and description' },
      { label: 'The change', detail: 'Commits and uncommitted work since the base branch' },
      { label: 'The repository', detail: 'Any file it needs to understand it' },
    ],
  },
  {
    name: 'Second pass',
    note: 'Intent and proof',
    sources: [
      { label: 'Your messages', detail: 'What you typed to Claude Code or Codex in this worktree' },
      { label: 'Screenshots', detail: 'Images uploaded to the pull request description' },
      { label: 'CI results', detail: 'The checks recorded on the pull request' },
    ],
  },
] as const;

const habits = [
  {
    title: 'Say what and why',
    body: 'What only your words explain ends up under “What the code doesn’t say”.',
    art: 'say',
  },
  {
    title: 'Verify by running',
    body: 'Ask the agent to start the app and use what it changed, not only compile it.',
    art: 'run',
  },
  {
    title: 'Open a pull request',
    body: 'Its text is read on the first pass, beside the code.',
    art: 'pr',
  },
  {
    title: 'Attach proof',
    body: 'Upload screenshots into the description. A link to a file in the repository is not read.',
    art: 'proof',
  },
  {
    title: 'One concern each',
    body: 'A small pull request reads as a few clear steps.',
    art: 'small',
  },
] as const;

const instructions = `## Before you hand back work

- Keep each pull request to one concern.
- Verify the change by running it: start the app with \`npm run dev\`, use what you changed, then run its tests.
- Take screenshots of what you ran.
- Open a pull request whose description says what changed, why, and how you verified it.
- Upload the screenshots into that description. Do not link to image files in the repository.
- Say what you could not verify.`;

const withoutPull = ['Write walkthrough', 'Comments answered by the walkthrough agent', 'Copy as prompt, for your coding agent'];
const withPull = ['Screenshots on the step they prove', 'Post on #42, alone or together', 'Automatic walkthroughs, if you turn them on'];

const leaves = [
  { not: 'Run or interrupt your coding agent', who: 'Your coding agent keeps building in its own app.' },
  { not: 'Edit your code', who: 'The walkthrough agent runs read-only.' },
  { not: 'Hunt for bugs', who: 'CI and review agents do that.' },
] as const;

const checklist = [
  'An AGENTS.md or CLAUDE.md that asks for running, a pull request and screenshots',
  'Your coding agent runs in the worktree Porcelain shows',
  'You told it what you want, and why',
  'One concern in this pull request',
  'Screenshots uploaded to its description, and the branch pushed',
  'A writer chosen in Settings, and Automatic on where you want it',
] as const;

const eyebrow = 'font-mono text-xs tracking-[0.18em] text-muted-foreground uppercase';
const heading = 'mt-5 text-[clamp(2.2rem,4.2vw,4rem)] leading-[0.98] font-semibold tracking-[-0.05em]';
const caption = 'mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground';
const card = 'rounded-2xl border border-border bg-card shadow-[0_30px_80px_-50px_rgb(0_0_0/0.35)]';
---

<Site title="Guide — Porcelain" description={description}>
  <main class="overflow-x-clip">
    <!-- Opening -->
    <section class="relative isolate mx-auto max-w-[1440px] px-5 pt-16 lg:px-10 lg:pt-28">
      <div
        class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_60%_70%_at_20%_0%,black,transparent)]"
        aria-hidden="true"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:64px_64px] opacity-70"
        >
        </div>
      </div>

      <p data-reveal class={eyebrow}>Guide</p>
      <h1 class="mt-6 text-[clamp(2.8rem,6.6vw,6.5rem)] leading-[0.94] font-semibold tracking-[-0.055em]">
        {
          headline.map((line) => (
            <span class:list={['block', line.tone]}>
              {line.words.map((word) => (
                <>
                  <span data-word class="inline-block">
                    {word}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p data-reveal class="mt-8 max-w-2xl text-lg leading-relaxed text-muted-foreground lg:text-xl lg:leading-relaxed">
        A walkthrough is only as rich as what the agent can read. Five habits in your repository fill it in.
      </p>
      <nav data-reveal class="mt-10 flex flex-wrap gap-2" aria-label="On this page">
        {
          chapters.map(([id, label]) => (
            <a
              class="inline-flex h-9 items-center rounded-full border border-border bg-background/70 px-4 text-sm text-muted-foreground no-underline backdrop-blur transition-colors hover:text-foreground"
              href={`#${id}`}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </section>

    <!-- What it reads -->
    <section id="reads" class="mx-auto max-w-[1440px] scroll-mt-24 px-5 pt-28 lg:px-10 lg:pt-40">
      <div class="max-w-3xl">
        <p data-reveal class={eyebrow}>What it reads</p>
        <h2 data-reveal class={heading}>
          Code first.{' '}<span class="text-muted-foreground">Then you.</span>
        </h2>
        <p data-reveal class={caption}>
          The walkthrough agent reads the change the way a new teammate would. Then it reads your messages, and writes
          down what only they explained.
        </p>
      </div>

      <div
        data-reveal
        data-reads
        class="mt-14 grid grid-cols-1 items-center gap-5 lg:grid-cols-[minmax(0,1fr)_4.5rem_minmax(0,15rem)_4.5rem_minmax(0,1fr)] lg:gap-0"
      >
        <div class="flex flex-col gap-5">
          {
            passes.map((pass, passIndex) => (
              <div class="rounded-2xl border border-border bg-card p-3">
                <div class="flex items-baseline justify-between px-2 pt-1 pb-3">
                  <span class="text-sm font-semibold tracking-[-0.01em]">{pass.name}</span>
                  <span class="text-xs text-muted-foreground">{pass.note}</span>
                </div>
                <ul class="flex flex-col gap-1.5">
                  {pass.sources.map((source) => (
                    <li
                      data-arrive
                      data-pass={passIndex}
                      class="flex items-center gap-3 rounded-xl bg-background px-3 py-2.5 shadow-[inset_0_0_0_1px_var(--border)]"
                    >
                      <span
                        class:list={[
                          'size-2 shrink-0 rounded-full',
                          passIndex === 0 ? 'bg-graph-1' : 'bg-graph-3',
                        ]}
                      />
                      <span class="min-w-0">
                        <span class="block text-sm font-medium">{source.label}</span>
                        <span class="block text-xs leading-snug text-muted-foreground">{source.detail}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="relative h-8 lg:h-20" aria-hidden="true">
          <div class="absolute top-0 bottom-0 left-1/2 w-px bg-border lg:top-1/2 lg:right-2 lg:bottom-auto lg:left-2 lg:h-px lg:w-auto"></div>
          <span data-flow="in" class="absolute top-0 left-1/2 size-2 -translate-x-1/2 rounded-full bg-graph-1 opacity-0 shadow-[0_0_12px_var(--graph-1)] lg:top-1/2 lg:left-2 lg:-translate-y-1/2"></span>
        </div>

        <div data-agent class="relative rounded-2xl bg-foreground p-6 text-background shadow-[0_30px_80px_-30px_rgb(0_0_0/0.5)]">
          <span class="absolute top-5 right-5 rounded-full border border-background/20 px-2 py-0.5 font-mono text-[0.68rem] text-background/70">read-only</span>
          <img src="/apple-touch-icon.png" alt="" width="40" height="40" class="size-10 rounded-xl" loading="lazy" />
          <p class="mt-5 text-lg font-semibold tracking-[-0.02em]">Walkthrough agent</p>
          <p class="mt-1 text-sm text-background/65">Your Claude Code or Codex CLI, on your machine.</p>
          <p class="mt-4 grid font-mono text-xs text-background/80 [&>*]:[grid-area:1/1]">
            <span data-agent-status="idle">Write walkthrough</span>
            <span data-agent-status="reading" class="opacity-0">Reading the change</span>
          </p>
        </div>

        <div class="relative h-8 lg:h-20" aria-hidden="true">
          <div class="absolute top-0 bottom-0 left-1/2 w-px bg-border lg:top-1/2 lg:right-2 lg:bottom-auto lg:left-2 lg:h-px lg:w-auto"></div>
          <span data-flow="out" class="absolute top-0 left-1/2 size-2 -translate-x-1/2 rounded-full bg-graph-2 opacity-0 shadow-[0_0_12px_var(--graph-2)] lg:top-1/2 lg:left-2 lg:-translate-y-1/2"></span>
        </div>

        <div class:list={[card, 'p-4']}>
          <p class="px-1 font-mono text-xs text-muted-foreground">Walkthrough</p>
          <p class="mt-2 px-1 text-lg font-semibold tracking-[-0.02em]">Find notes by title</p>
          <div class="mt-4 flex flex-col gap-2">
            <div data-fill="calls" class="rounded-xl border border-border bg-background p-3">
              <p class="flex justify-between text-xs text-muted-foreground"><span>Product call</span><span>Step 1</span></p>
              <p class="mt-1 text-sm font-medium">Should an empty search show every note?</p>
            </div>
            <div data-fill="grew" class="rounded-xl border border-border bg-background p-3">
              <p class="text-xs font-semibold">How the system grew</p>
              <p class="mt-1 text-xs text-muted-foreground">+ Title search&ensp;+ Result label</p>
            </div>
            <div data-fill="steps" class="rounded-xl border border-border bg-background p-3">
              <p class="font-mono text-[0.7rem] text-muted-foreground">Step 1 · Step 2</p>
              <div class="mt-1 flex items-center justify-between gap-3">
                <p class="text-sm font-medium">Choose the empty search behavior</p>
                <span data-arrive data-pass="1" class="block h-7 w-10 shrink-0 rounded-md bg-muted shadow-[inset_0_0_0_1px_var(--border)]">
                  <span class="mx-1.5 mt-1.5 block h-1 rounded-full bg-graph-3/60"></span>
                  <span class="mx-1.5 mt-1 block h-1 w-4 rounded-full bg-border"></span>
                </span>
              </div>
            </div>
            <div data-fill="unsaid" class="rounded-xl border border-border bg-background p-3">
              <p class="text-xs font-semibold">What the code doesn’t say</p>
              <p class="mt-1 text-xs text-muted-foreground">Empty search: you wanted a quiet first view</p>
            </div>
          </div>
        </div>
      </div>

      <div data-reveal class="mt-5 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-2">
        <div class="bg-background p-6">
          <p class="font-semibold tracking-[-0.02em]">Say what you want and why</p>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">In your own words, to your coding agent.</p>
        </div>
        <div class="bg-background p-6">
          <p class="font-semibold tracking-[-0.02em]">Stay in the worktree</p>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">Sessions are matched by the worktree’s folder.</p>
        </div>
      </div>
    </section>

    <!-- Proof -->
    <section id="proof" class="mx-auto max-w-[1440px] scroll-mt-24 px-5 pt-28 lg:px-10 lg:pt-40">
      <div class="max-w-3xl">
        <p data-reveal class={eyebrow}>Proof</p>
        <h2 data-reveal class={heading}>
          No screenshot, nothing shown.{' '}<span class="text-muted-foreground">On purpose.</span>
        </h2>
        <p data-reveal class={caption}>
          Porcelain’s agent never makes evidence up. Images uploaded to the pull request description land on the step
          they prove.
        </p>
      </div>

      <div data-reveal data-proof class="mt-14 grid grid-cols-1 items-start gap-5 md:grid-cols-2">
        {
          [false, true].map((attached) => (
            <figure class="min-w-0">
              <figcaption class="mb-3 flex items-center gap-2 text-sm text-muted-foreground">
                <span class:list={['size-2 rounded-full', attached ? 'bg-graph-2' : 'bg-border']} />
                {attached ? 'With screenshots on the pull request' : 'Without'}
              </figcaption>
              <div class:list={[card, 'p-5 sm:p-6']}>
                <p class="font-mono text-xs text-muted-foreground">
                  Step 1<span class="ml-2 text-foreground">Your call</span>
                </p>
                <p class="mt-2 text-lg font-semibold tracking-[-0.02em]">Choose the empty search behavior</p>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                  Search matches a title when it contains the query. An empty query currently returns every note.
                </p>
                {attached && (
                  <div class="mt-4 flex gap-3">
                    {[0, 1].map((index) => (
                      <div data-shot class="flex w-36 shrink-0 flex-col gap-1.5">
                        <div class="aspect-[4/3] overflow-hidden rounded-lg bg-background p-2 shadow-[0_0_0_1px_var(--border),0_8px_24px_-12px_rgb(0_0_0/0.35)]">
                          <div class="flex h-4 items-center rounded-md border border-border px-1.5">
                            <span class="h-1 w-8 rounded-full bg-graph-3/70" />
                          </div>
                          {index === 0 ? (
                            <div class="mt-2 flex flex-col gap-1.5">
                              {[0, 1, 2, 3].map(() => (
                                <span class="h-2 rounded bg-foreground/15" />
                              ))}
                            </div>
                          ) : (
                            <div class="mt-2 flex h-[calc(100%-1.5rem)] items-center justify-center">
                              <span class="h-2 w-14 rounded bg-foreground/15" />
                            </div>
                          )}
                        </div>
                        <span class="text-xs leading-4 text-muted-foreground">
                          {index === 0 ? 'An empty search lists every note.' : 'Typing a title narrows the list.'}
                        </span>
                      </div>
                    ))}
                  </div>
                )}
                <p class="mt-4 text-sm font-medium underline decoration-border underline-offset-4">See the code</p>
              </div>
            </figure>
          ))
        }
      </div>

      <div data-reveal class="mt-5 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-2">
        <div class="bg-background p-6">
          <p class="font-semibold tracking-[-0.02em]">Push first</p>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">It reads the pull request at the commit it explains.</p>
        </div>
        <div class="bg-background p-6">
          <p class="font-semibold tracking-[-0.02em]">PNG, JPEG, WebP or GIF</p>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">Up to twenty images from the description, each under 10 MB.</p>
        </div>
      </div>
    </section>

    <!-- Habits -->
    <section id="habits" class="mx-auto max-w-[1440px] scroll-mt-24 px-5 pt-28 lg:px-10 lg:pt-40">
      <div class="max-w-3xl">
        <p data-reveal class={eyebrow}>Habits</p>
        <h2 data-reveal class={heading}>
          An agent-ready repository.{' '}<span class="text-muted-foreground">Five habits.</span>
        </h2>
        <p data-reveal class={caption}>None of them is about Porcelain. Each one makes a change easier to trust.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 xl:grid-cols-5">
        {
          habits.map((habit, index) => (
            <div data-reveal class:list={['flex flex-col bg-background p-6 lg:p-7', index === habits.length - 1 && 'sm:col-span-2 xl:col-span-1']}>
              <div class="flex h-28 items-center justify-center rounded-xl bg-muted/60 p-3" aria-hidden="true">
                {habit.art === 'say' && (
                  <div class="w-full max-w-[12rem]">
                    <div class="ml-auto w-fit rounded-2xl bg-background px-3 py-1.5 text-[0.7rem] leading-snug shadow-[inset_0_0_0_1px_var(--border)]">
                      Show none until someone types. The full list is noise.
                    </div>
                    <p class="mt-2 text-[0.65rem] text-muted-foreground">→ What the code doesn’t say</p>
                  </div>
                )}
                {habit.art === 'run' && (
                  <div class="w-full max-w-[12rem] rounded-lg bg-foreground p-2.5 font-mono text-[0.65rem] leading-relaxed text-background">
                    <p>
                      <span class="opacity-50">$</span> npm run dev
                    </p>
                    <p class="opacity-60">ready on :3000</p>
                    <p class="text-graph-2">✓ used the search</p>
                  </div>
                )}
                {habit.art === 'pr' && (
                  <div class="w-full max-w-[12rem] rounded-lg border border-border bg-background p-2.5 text-[0.65rem] leading-relaxed">
                    <p class="font-semibold">Find notes by title #42</p>
                    <p class="mt-1 text-muted-foreground">What · Why · How it was verified</p>
                  </div>
                )}
                {habit.art === 'proof' && (
                  <div class="flex w-full max-w-[12rem] items-center gap-2">
                    <span class="block h-10 w-12 shrink-0 rounded-md border border-border bg-background p-1">
                      <span class="block h-1.5 rounded-full bg-graph-3/60" />
                      <span class="mt-1 block h-1.5 w-6 rounded-full bg-muted" />
                    </span>
                    <span class="text-muted-foreground">→</span>
                    <span class="block flex-1 rounded-md border border-border bg-background p-1.5 text-[0.6rem] text-muted-foreground">
                      Description
                      <span class="mt-1 block h-4 rounded bg-graph-3/20" />
                    </span>
                  </div>
                )}
                {habit.art === 'small' && (
                  <div class="flex items-end gap-3">
                    <span class="flex flex-col items-center gap-1 text-[0.6rem] text-muted-foreground">
                      <span class="flex gap-0.5">
                        <span class="h-6 w-2 rounded-sm bg-graph-1/70" />
                        <span class="h-6 w-2 rounded-sm bg-graph-1/70" />
                      </span>
                      2 steps
                    </span>
                    <span class="flex flex-col items-center gap-1 text-[0.6rem] text-muted-foreground">
                      <span class="flex gap-0.5">
                        {Array.from({ length: 9 }, () => (
                          <span class="h-6 w-1 rounded-sm bg-border" />
                        ))}
                      </span>
                      everything
                    </span>
                  </div>
                )}
              </div>
              <span class="mt-6 font-mono text-xs text-muted-foreground">0{index + 1}</span>
              <h3 class="mt-2 text-lg font-semibold tracking-[-0.025em]">{habit.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{habit.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Instructions -->
    <section id="instructions" class="mx-auto max-w-[1440px] scroll-mt-24 px-5 pt-28 lg:px-10 lg:pt-40">
      <div class="max-w-3xl">
        <p data-reveal class={eyebrow}>Instructions</p>
        <h2 data-reveal class={heading}>
          Tell your agent once.{' '}<span class="text-muted-foreground">It does it every time.</span>
        </h2>
        <p data-reveal class={caption}>Paste this into AGENTS.md or CLAUDE.md, then change the commands to yours.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 items-center gap-5 lg:grid-cols-[minmax(0,1.15fr)_3rem_minmax(0,1fr)] lg:gap-0">
        <div data-reveal class="min-w-0">
          <Snippet file="AGENTS.md" text={instructions} />
        </div>
        <div class="hidden justify-center text-muted-foreground lg:flex" aria-hidden="true">→</div>
        <figure data-reveal class="min-w-0">
          <figcaption class="mb-3 text-sm text-muted-foreground">The pull request it opens</figcaption>
          <div class:list={[card, 'p-5 sm:p-6']}>
            <p class="text-lg font-semibold tracking-[-0.02em]">
              Find notes by title <span class="font-normal text-muted-foreground">#42</span>
            </p>
            <dl class="mt-4 flex flex-col gap-3 text-sm">
              <div>
                <dt class="font-semibold">What and why</dt>
                <dd class="mt-0.5 text-muted-foreground">Search notes by title. People could not find old notes.</dd>
              </div>
              <div>
                <dt class="font-semibold">Verified</dt>
                <dd class="mt-0.5 text-muted-foreground">Ran the app, searched with and without a query, ran the search tests.</dd>
              </div>
              <div>
                <dt class="font-semibold">Not verified</dt>
                <dd class="mt-0.5 text-muted-foreground">A library with thousands of notes.</dd>
              </div>
            </dl>
            <div class="mt-4 flex gap-2" aria-hidden="true">
              {[0, 1].map(() => (
                <span class="block h-14 w-20 rounded-md border border-border bg-background p-1.5">
                  <span class="block h-2 rounded-sm border border-border" />
                  <span class="mt-1.5 block h-1.5 rounded-full bg-muted" />
                  <span class="mt-1 block h-1.5 w-8 rounded-full bg-muted" />
                </span>
              ))}
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- Pull requests -->
    <section id="pull-requests" class="mx-auto max-w-[1440px] scroll-mt-24 px-5 pt-28 lg:px-10 lg:pt-40">
      <div class="max-w-3xl">
        <p data-reveal class={eyebrow}>Pull requests</p>
        <h2 data-reveal class={heading}>
          Everything works locally.{' '}<span class="text-muted-foreground">A pull request adds three things.</span>
        </h2>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2">
        {
          [
            { title: 'Without a pull request', items: withoutPull, tone: 'bg-border' },
            { title: 'With one', items: withPull, tone: 'bg-graph-2' },
          ].map((column) => (
            <div data-reveal class:list={[card, 'p-6 sm:p-7']}>
              <p class="flex items-center gap-2 font-semibold tracking-[-0.02em]">
                <span class:list={['size-2 rounded-full', column.tone]} />
                {column.title}
              </p>
              <ul class="mt-4 flex flex-col gap-2.5 text-sm text-muted-foreground">
                {column.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-graph-2" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                      <path d="m5 12.5 4.5 4.5L19 7.5" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div data-reveal data-post class="mt-5 grid grid-cols-1 items-center gap-5 lg:grid-cols-[minmax(0,1fr)_4rem_minmax(0,1fr)] lg:gap-0">
        <div class:list={[card, 'p-5 sm:p-6']}>
