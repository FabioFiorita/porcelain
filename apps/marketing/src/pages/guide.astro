        <article data-reveal class="flex flex-col rounded-3xl border border-border bg-card p-6 lg:p-8">
          <div class="rounded-xl border border-border bg-background p-4 text-sm" aria-hidden="true">
            <p class="text-xs text-muted-foreground">Write walkthroughs</p>
            <ul data-mode class="mt-2 flex flex-col gap-1 rounded-lg border border-border p-1">
              {['Manual', 'Automatic when a pull request opens'].map((option, index) => (
                <li data-mode-option={index} class="flex items-center justify-between gap-3 rounded-md px-2.5 py-1.5">
                  {option}
                  <svg data-mode-check viewBox="0 0 24 24" class:list={['size-4 shrink-0', index === 1 && 'opacity-0']} fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                </li>
              ))}
            </ul>
          </div>
          <h3 class="mt-6 text-xl font-semibold tracking-[-0.03em]">Manual or automatic</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            Manual waits for Write walkthrough. Automatic writes one when a pull request opens for a branch checked out in Porcelain.
          </p>
        </article>

        <article data-reveal data-stale class="flex flex-col rounded-3xl border border-border bg-card p-6 lg:p-8">
          <div class="rounded-xl border border-border bg-background p-4 text-sm" aria-hidden="true">
            <div class="flex items-center gap-2">
              <span class="size-2.5 rounded-full bg-graph-1"></span>
              <span class="h-px w-6 bg-border"></span>
              <span class="size-2.5 rounded-full bg-graph-1"></span>
              <span class="h-px w-6 bg-border"></span>
              <span data-stale-commit class="size-2.5 rounded-full bg-graph-4 ring-4 ring-graph-4/20"></span>
              <span class="ml-auto font-mono text-[0.68rem] text-muted-foreground">new commit</span>
            </div>
            <div class="mt-4 grid [&>*]:[grid-area:1/1]">
              <div data-stale-notice class="flex flex-col items-start gap-2">
                <span class="text-muted-foreground">The work changed after this was written.</span>
                <span data-stale-button class="inline-flex h-8 items-center rounded-lg border border-border px-3 font-medium">Update walkthrough</span>
              </div>
              <div data-stale-updating class="flex items-start text-muted-foreground opacity-0">Updating…</div>
            </div>
          </div>
          <h3 class="mt-6 text-xl font-semibold tracking-[-0.03em]">Out of date, then Update</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            New commits or edits mark the page out of date. The old page stays readable while Update writes the new one.
          </p>
        </article>
      </div>
    </section>

    <!-- What it leaves to others -->
    <section class="mx-auto max-w-[1440px] px-5 pt-28 lg:px-10 lg:pt-40">
      <div class="max-w-3xl">
        <p data-reveal class={eyebrow}>What it does not do</p>
        <h2 data-reveal class={heading}>
          It explains.{' '}<span class="text-muted-foreground">The rest has an owner.</span>
        </h2>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-2 xl:grid-cols-4">
        {
          leaves.map((item) => (
            <div data-reveal class="bg-background p-7">
              <p class="text-lg font-semibold tracking-[-0.025em] text-muted-foreground line-through decoration-muted-foreground/50">
                {item.not}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.who}</p>
            </div>
          ))
        }
        <div data-reveal class="bg-foreground p-7 text-background">
          <p class="text-lg font-semibold tracking-[-0.025em]">You</p>
          <p class="mt-2 text-sm leading-relaxed text-background/65">Make the few calls, and keep a picture of how your system is built.</p>
        </div>
      </div>
    </section>

    <!-- Checklist -->
    <section id="checklist" class="mx-auto max-w-[1440px] scroll-mt-24 px-5 pt-28 pb-24 lg:px-10 lg:pt-40 lg:pb-32">
      <div
        data-reveal
        class="relative isolate overflow-hidden rounded-[2rem] bg-foreground px-6 py-14 text-background sm:px-8 lg:px-16 lg:py-20"
      >
        <div
          class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,color-mix(in_oklab,var(--background)_9%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_oklab,var(--background)_9%,transparent)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_60%_80%_at_100%_0%,black,transparent)]"
          aria-hidden="true"
        >
        </div>
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)] lg:gap-20">
          <div>
            <h2 class="max-w-[14ch] text-[clamp(2.4rem,5vw,4.75rem)] leading-[0.95] font-semibold tracking-[-0.055em]">
              Before your next walkthrough.
            </h2>
            <div class="mt-10 flex flex-wrap items-center gap-3">
              <a
                class="inline-flex h-11 items-center gap-2 rounded-full bg-background px-5 text-sm font-medium text-foreground no-underline transition-transform hover:scale-[1.03] active:scale-[0.98]"
                href="/install"
              >
                Download
              </a>
              <Command command={serve} tone="inverse" />
            </div>
          </div>
          <ul class="flex flex-col gap-1">
            {
              checklist.map((item) => (
                <li>
                  <label class="flex cursor-pointer items-start gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-background/10">
                    <input type="checkbox" class="peer sr-only" />
                    <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-md shadow-[inset_0_0_0_1.5px_color-mix(in_oklab,var(--background)_45%,transparent)] peer-checked:bg-background peer-checked:text-foreground peer-focus-visible:ring-2 peer-focus-visible:ring-background/60 [&>svg]:opacity-0 peer-checked:[&>svg]:opacity-100">
                      <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                        <path d="m5 12.5 4.5 4.5L19 7.5" />
                      </svg>
                    </span>
                    <span class="leading-relaxed text-background/80 peer-checked:text-background">{item}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { animate, inView, stagger } from 'motion';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const spring = { type: 'spring', stiffness: 120, damping: 22, mass: 0.9 } as const;
    const ease = [0.22, 1, 0.36, 1] as const;
    const instant = { duration: 0 };
    const all = (selector: string, root: ParentNode = document) => Array.from(root.querySelectorAll<HTMLElement>(selector));
    const one = (selector: string, root: ParentNode = document) => root.querySelector<HTMLElement>(selector);
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    /* Runs a demo while its element is in view. Leaving ends that run, so coming back never stacks a second loop. */
    function whileVisible(element: Element, amount: number, play: (live: () => boolean) => Promise<void>) {
      let generation = 0;
      inView(
        element,
        () => {
          const run = ++generation;
          void play(() => run === generation);
          return () => {
            generation += 1;
          };
        },
        { amount },
      );
    }

    /* A dot runs along a connector. On a phone the connector is vertical, so it travels down instead of across. */
    async function travel(dot: HTMLElement) {
      const across = window.matchMedia('(min-width: 64rem)').matches;
      const track = dot.parentElement;
      const distance = track ? (across ? track.clientWidth - 16 : track.clientHeight - 8) : 0;
      await animate(
        dot,
        across ? { x: [0, distance], opacity: [0, 1, 1, 0] } : { y: [0, distance], opacity: [0, 1, 1, 0] },
        { duration: 0.9, ease: 'easeInOut' },
      );
    }

    /* The first pass arrives and fills the calls, the growth and the steps. The second adds the screenshot and what only you said. */
    function playReads() {
      const diagram = one('[data-reads]');
      if (!diagram) return;
      const first = all('[data-arrive][data-pass="0"]', diagram);
      const second = all('[data-arrive][data-pass="1"]', diagram);
      const thumb = second.find((element) => element.tagName === 'SPAN');
      const sources = second.filter((element) => element !== thumb);
      const fills = Object.fromEntries(all('[data-fill]', diagram).map((element) => [element.dataset.fill, element]));
      const flowIn = one('[data-flow="in"]', diagram);
      const flowOut = one('[data-flow="out"]', diagram);
      const idle = one('[data-agent-status="idle"]', diagram);
      const reading = one('[data-agent-status="reading"]', diagram);
      if (!flowIn || !flowOut || !idle || !reading || !thumb) return;
      const status = (busy: boolean) => {
        animate(idle, { opacity: busy ? 0 : 1 }, { duration: 0.25 });
        animate(reading, { opacity: busy ? [0.4, 1, 0.4, 1] : 0 }, { duration: busy ? 1.4 : 0.25 });
      };
      const light = (key: string) => {
        const element = fills[key];
        if (element) animate(element, { opacity: [0.3, 1], scale: [0.98, 1] }, spring);
      };

      whileVisible(diagram, 0.3, async (live) => {
        while (live()) {
          animate([...first, ...sources, thumb], { opacity: 0 }, instant);
          animate(Object.values(fills), { opacity: 0.3 }, instant);
          await wait(300);
          await animate(first, { opacity: [0, 1], x: [-12, 0] }, { delay: stagger(0.18), duration: 0.5, ease });
          if (!live()) return;
          status(true);
          await travel(flowIn);
          await wait(500);
          if (!live()) return;
          await travel(flowOut);
          light('calls');
          await wait(250);
          light('grew');
          await wait(250);
          light('steps');
          status(false);
          await wait(900);
          if (!live()) return;
          await animate(sources, { opacity: [0, 1], x: [-12, 0] }, { delay: stagger(0.18), duration: 0.5, ease });
          if (!live()) return;
          status(true);
          await travel(flowIn);
          await wait(500);
          if (!live()) return;
          await travel(flowOut);
          animate(thumb, { opacity: [0, 1], y: [-14, 0], scale: [0.8, 1] }, spring);
          light('unsaid');
          status(false);
          await wait(4200);
        }
      });
    }

    /* The screenshots drop onto the step they prove. */
    function playProof() {
      const proof = one('[data-proof]');
      if (!proof) return;
      const shots = all('[data-shot]', proof);
      whileVisible(proof, 0.4, async (live) => {
        while (live()) {
          animate(shots, { opacity: 0 }, instant);
          await wait(700);
          if (!live()) return;
          for (const shot of shots) {
            animate(shot, { opacity: [0, 1], y: [-28, 0], rotate: [-3, 0] }, spring);
            await wait(260);
          }
          await wait(4200);
        }
      });
    }

    /* Post on #42 sends the comment, with its step and the agent's answer, to the pull request. */
    function playPost() {
      const post = one('[data-post]');
      if (!post) return;
      const before = one('[data-post-before]', post);
      const after = one('[data-post-after]', post);
      const button = one('[data-post-button]', post);
      const flow = one('[data-post-flow]', post);
      const comment = one('[data-post-comment]', post);
      if (!before || !after || !button || !flow || !comment) return;
      whileVisible(post, 0.4, async (live) => {
        while (live()) {
          animate(before, { opacity: 1 }, instant);
          animate([after, comment], { opacity: 0 }, instant);
          await wait(1200);
          if (!live()) return;
          await animate(button, { scale: [1, 0.94, 1] }, { duration: 0.25 });
          await travel(flow);
          animate(comment, { opacity: [0, 1], y: [12, 0] }, spring);
          animate(before, { opacity: 0 }, { duration: 0.2 });
          animate(after, { opacity: [0, 1] }, { duration: 0.3 });
          await wait(4200);
        }
      });
    }

    /* The writer switches between providers, and the mode between manual and automatic. */
    function playSettings() {
      const writer = one('[data-writer]');
      const mode = one('[data-mode]');
      if (!writer || !mode) return;
      const providers = all('[data-writer-option]', writer);
      const checks = all('[data-mode-check]', mode);
      const pick = (index: number) => {
        for (const [current, option] of providers.entries()) {
          option.classList.toggle('bg-background', current === index);
          option.classList.toggle('shadow-[0_0_0_1px_var(--border)]', current === index);
          option.classList.toggle('text-muted-foreground', current !== index);
        }
        for (const [current, check] of checks.entries()) {
          animate(check, { opacity: current === index ? 1 : 0, scale: current === index ? [0.6, 1] : 1 }, spring);
        }
      };
      whileVisible(writer, 0.5, async (live) => {
        let index = 0;
        while (live()) {
          await wait(2600);
          if (!live()) return;
          index = 1 - index;
          pick(index);
        }
      });
    }

    /* A commit lands, the page says it is out of date, and Update writes a new one. */
    function playStale() {
      const stale = one('[data-stale]');
      if (!stale) return;
      const commit = one('[data-stale-commit]', stale);
      const notice = one('[data-stale-notice]', stale);
      const button = one('[data-stale-button]', stale);
      const updating = one('[data-stale-updating]', stale);
      if (!commit || !notice || !button || !updating) return;
      whileVisible(stale, 0.5, async (live) => {
        while (live()) {
          animate([commit, notice, updating], { opacity: 0 }, instant);
          await wait(900);
          if (!live()) return;
          await animate(commit, { opacity: [0, 1], scale: [0.4, 1] }, spring);
          await animate(notice, { opacity: [0, 1], y: [6, 0] }, { duration: 0.4 });
          await wait(1400);
          if (!live()) return;
          await animate(button, { scale: [1, 0.94, 1] }, { duration: 0.25 });
          animate(notice, { opacity: 0 }, { duration: 0.2 });
          await animate(updating, { opacity: [0, 1, 0.4, 1, 0.4, 1] }, { duration: 2 });
          if (!live()) return;
          animate(updating, { opacity: 0 }, { duration: 0.3 });
          await animate(commit, { backgroundColor: ['var(--graph-4)', 'var(--graph-1)'] }, { duration: 0.5 });
          await wait(2400);
          animate(commit, { backgroundColor: 'var(--graph-4)' }, instant);
        }
      });
    }

    if (!reduced) {
      playReads();
      playProof();
      playPost();
      playSettings();
      playStale();
    }
  </script>
</Site>
