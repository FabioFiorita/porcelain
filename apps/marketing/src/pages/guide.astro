        <div class="relative h-8 lg:h-20" aria-hidden="true">
          <div class="absolute top-0 bottom-0 left-1/2 w-px bg-border lg:top-1/2 lg:right-2 lg:bottom-auto lg:left-2 lg:h-px lg:w-auto"></div>
          <span data-post-flow class="absolute top-0 left-1/2 size-2 -translate-x-1/2 rounded-full bg-graph-1 opacity-0 shadow-[0_0_12px_var(--graph-1)] lg:top-1/2 lg:left-2 lg:-translate-y-1/2"></span>
