---
import Site from '../layouts/site.astro';
import GithubMark from '../components/github-mark.astro';

const description =
  'Porcelain has no account, no analytics, and no copy of your code. Here is everything it knows about you, and the source to prove it.';
const github = 'https://github.com/FabioFiorita/porcelain';

const headline = [
  { words: ['You', 'opened', 'the', 'privacy', 'page.'], tone: 'text-foreground' },
  { words: ['Almost', 'nobody', 'does.'], tone: 'text-muted-foreground' },
];

const answers = [
  {
    question: 'Do I need an account?',
    answer:
      'No. There is no sign-up, no login and no “Continue with Google”. We would not know what to do with your email anyway.',
  },
  {
    question: 'Where does my code go?',
    answer:
      'Nowhere. It stays on the computer that holds the repository. The browser, the Mac app and, soon, your phone read it from there. Pairing gives each device its own key to that one computer, and nothing to us.',
  },
  {
    question: 'And the walkthroughs and comments?',
    answer:
      'Same computer, in Porcelain’s own folder, ~/.porcelain unless you choose another. Delete it and they are gone. We never had a copy to lose.',
  },
  {
    question: 'Analytics? Crash reports? One tiny pixel?',
    answer:
      'None in the app and none on this site. We genuinely do not know how many people read this page. If it is just you, hello.',
  },
  {
    question: 'Does it ever talk to the internet?',
    answer:
      'The Mac app asks GitHub whether a new version is out, and updating the server asks npm the same question. Those requests carry a version number, not your code.',
  },
  {
    question: 'What about working remotely?',
    answer:
      'You reach your own computer over your own network or your own Tailscale. There is no Porcelain server in the middle, because there is no Porcelain server.',
  },
  {
    question: 'And my agent?',
    answer:
      'Your agent is its own app with its own policy. Porcelain sends your prompts and code nowhere, but the agent may send what it reads to its provider. Read their privacy page too. You are clearly the kind of person who does.',
  },
  {
    question: 'This website?',
    answer:
      'Static pages. No cookies, no sign-in, no trackers. The host keeps the ordinary request logs any website has, and we do not look at them for fun.',
  },
] as const;
---

<Site title="Privacy — Porcelain" description={description}>
  <main class="overflow-x-clip">
    <section class="relative isolate mx-auto max-w-[1440px] px-5 pt-16 lg:px-10 lg:pt-28">
      <div
        class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_60%_70%_at_20%_0%,black,transparent)]"
        aria-hidden="true"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:64px_64px] opacity-70"
        >
        </div>
      </div>

      <p data-reveal class="font-mono text-xs tracking-[0.18em] text-muted-foreground uppercase">Privacy</p>
      <h1 class="mt-6 text-[clamp(2.8rem,6.6vw,6.5rem)] leading-[0.94] font-semibold tracking-[-0.055em]">
        {
          headline.map((line) => (
            <span class:list={['block', line.tone]}>
              {line.words.map((word) => (
                <>
                  <span data-word class="inline-block">
                    {word}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p data-reveal class="mt-8 max-w-2xl text-lg leading-relaxed text-muted-foreground lg:text-xl lg:leading-relaxed">
        So you care where your code goes. Good, so do we. Here is everything Porcelain has ever collected about you.
      </p>

      <div
        data-reveal
        class="mt-14 grid grid-cols-1 items-center gap-8 rounded-3xl border border-border bg-card p-8 shadow-[0_30px_80px_-50px_rgb(0_0_0/0.35)] lg:grid-cols-2 lg:gap-14 lg:p-14"
      >
        <p
          data-zero
          class="font-mono text-[clamp(4.5rem,10vw,9rem)] leading-none font-semibold tracking-[-0.06em] tabular-nums"
          aria-label="0"
        >
          0
        </p>
        <div>
          <p class="text-2xl font-semibold tracking-[-0.035em] lg:text-3xl">Bytes of your code we have received.</p>
          <p class="mt-3 text-muted-foreground">Also zero: accounts, emails, cookies, analytics events and crash reports.</p>
          <p class="mt-5 font-mono text-sm text-muted-foreground/80">// That was the whole database.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1440px] px-5 pt-24 lg:px-10 lg:pt-36">
      <h2 data-reveal class="text-[clamp(2rem,3.6vw,3.25rem)] leading-[1] font-semibold tracking-[-0.045em]">
        The longer version.{' '}
        <span class="text-muted-foreground">Still short.</span>
      </h2>
      <dl class="mt-12 border-t border-border">
        {
          answers.map((item) => (
            <div
              data-reveal
              class="grid grid-cols-1 gap-3 border-b border-border py-8 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-16 lg:py-10"
            >
              <dt class="text-xl font-semibold tracking-[-0.03em] lg:text-2xl">{item.question}</dt>
              <dd class="max-w-2xl text-lg leading-relaxed text-muted-foreground">{item.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mx-auto max-w-[1440px] px-5 pt-24 pb-24 lg:px-10 lg:pt-32 lg:pb-32">
      <div
        data-reveal
        class="relative isolate overflow-hidden rounded-[2rem] bg-foreground px-8 py-16 text-background lg:px-16 lg:py-24"
      >
        <div
          class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,color-mix(in_oklab,var(--background)_9%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_oklab,var(--background)_9%,transparent)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_60%_80%_at_100%_0%,black,transparent)]"
          aria-hidden="true"
        >
        </div>
        <p class="text-[clamp(2.4rem,5.4vw,5rem)] leading-[0.95] font-semibold tracking-[-0.055em] text-background/55">
          Don’t trust me?
        </p>
        <p class="text-[clamp(2.4rem,5.4vw,5rem)] leading-[0.95] font-semibold tracking-[-0.055em]">Check the source.</p>
        <p class="mt-8 max-w-lg text-lg leading-relaxed text-background/65">
          Every line is on GitHub under the MIT license: the server, the apps, the updater, and this page. Anything that
          could send your code somewhere would have to be in there.
        </p>
        <a
          class="mt-10 inline-flex h-11 items-center gap-2 rounded-full bg-background px-5 text-sm font-medium text-foreground no-underline transition-transform hover:scale-[1.03] active:scale-[0.98]"
          href={github}
        >
          <GithubMark />
          Read the source
        </a>
      </div>
    </section>
  </main>

  <script>
    import { animate, inView } from 'motion';

    /* The counter spins through a lot of bytes and lands where it always was. */
    const zero = document.querySelector<HTMLElement>('[data-zero]');
    if (zero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      inView(
        zero,
        () => {
          animate(99_999, 0, {
            duration: 2.4,
            ease: [0.16, 1, 0.3, 1],
            onUpdate: (value) => {
              zero.textContent = Math.round(value).toLocaleString('en-US');
            },
          });
        },
        { amount: 0.6 },
      );
    }
  </script>
</Site>
