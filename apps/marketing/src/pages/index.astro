        <p class="mt-6 max-w-lg text-lg leading-relaxed text-background/65">
          Start the server on the machine that holds your repositories, or download the Mac app.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            class="inline-flex h-11 items-center gap-2 rounded-full bg-background px-5 text-sm font-medium text-foreground no-underline transition-transform hover:scale-[1.03] active:scale-[0.98]"
            href="/install"
          >
            Download
          </a>
          <Command command={serve} tone="inverse" />
