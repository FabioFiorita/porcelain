---
import '../styles/global.css';
import walkthrough from '../../../../docs/readme/walkthrough.png';
import comments from '../../../../docs/readme/comments.png';
import proof from '../../../../docs/readme/proof.png';

const description =
  'A companion for the coding agents you already run. They publish a walkthrough of what changed. You read it, comment, and decide what to keep.';

const sections = [
  ['walkthrough', 'Walkthrough'],
  ['comments', 'Comments'],
  ['proof', 'Proof'],
  ['files', 'Files'],
  ['history', 'History'],
  ['remote', 'Remote'],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <title>Porcelain</title>
  </head>
  <body class="bg-background text-foreground font-sans text-base leading-normal tracking-[-0.011em] antialiased">
    <header class="sticky top-0 z-20 border-b border-border/70 bg-background/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-5 py-3 lg:px-10">
        <a class="text-lg font-medium tracking-[-0.03em] text-foreground no-underline" href="#top">Porcelain</a>
        <nav class="hidden items-center gap-5 text-sm text-muted-foreground xl:flex" aria-label="On this page">
          {
            sections.map(([id, label]) => (
              <a class="no-underline hover:text-foreground" href={`#${id}`}>
                {label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-1 sm:gap-2">
          <a
            class="inline-flex h-9 items-center gap-2 rounded-full px-2.5 text-sm whitespace-nowrap text-muted-foreground no-underline hover:bg-accent hover:text-foreground sm:px-3"
            href="https://github.com/FabioFiorita/porcelain"
          >
            <svg viewBox="0 0 1024 1024" class="size-4" aria-hidden="true">
              <path
                fill="currentColor"
                fill-rule="evenodd"
                d="M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-128.64 23.68-161.92-31.36-172.16-60.16-5.76-14.72-30.72-60.16-52.48-72.32-17.92-9.6-43.52-33.28-.64-33.92 40.32-.64 69.12 37.12 78.72 52.48 46.08 77.44 119.68 55.68 149.12 42.24 4.48-33.28 17.92-55.68 32.64-68.48-113.92-12.8-232.96-56.96-232.96-252.8 0-55.68 19.84-101.76 52.48-137.6-5.12-12.8-23.04-65.28 5.12-135.68 0 0 42.88-13.44 140.8 52.48 40.96-11.52 84.48-17.28 128-17.28s87.04 5.76 128 17.28c97.92-66.56 140.8-52.48 140.8-52.48 28.16 70.4 10.24 122.88 5.12 135.68 32.64 35.84 52.48 81.28 52.48 137.6 0 196.48-119.68 240-233.6 252.8 18.56 16 34.56 46.72 34.56 94.72 0 68.48-.64 123.52-.64 140.8 0 13.44 9.6 29.44 35.2 24.32C877.44 929.92 1024 737.92 1024 512 1024 229.12 794.88 0 512 0"
                clip-rule="evenodd"></path>
            </svg>
            Source
          </a>
          <a
            class="inline-flex h-9 items-center gap-2 rounded-full bg-foreground px-3 text-sm whitespace-nowrap text-background no-underline sm:px-3.5"
            href="https://github.com/FabioFiorita/porcelain/releases"
          >
            <svg viewBox="0 0 814 1000" class="size-4" aria-hidden="true">
              <path
                fill="currentColor"
                d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
              ></path>
            </svg>
            Download for Mac
          </a>
        </div>
      </div>
      <nav
        class="mx-auto flex max-w-[1440px] gap-4 overflow-x-auto px-5 pb-3 text-sm text-muted-foreground xl:hidden"
        aria-label="On this page"
      >
        {
          sections.map(([id, label]) => (
            <a class="shrink-0 no-underline hover:text-foreground" href={`#${id}`}>
              {label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="top" class="mx-auto max-w-[1440px] px-5 pb-24 lg:px-10">
      <section class="grid items-end gap-8 pt-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:pt-20">
        <h1
          class="animate-in slide-in-from-bottom-6 fill-mode-both text-[clamp(2.85rem,4.35vw,4.35rem)] leading-[0.96] font-medium tracking-[-0.045em] duration-700"
        >
          Agents write the code.<br />This is where you read it.
        </h1>
        <div class="animate-in slide-in-from-bottom-6 fill-mode-both delay-150 max-w-md duration-700 lg:pb-2">
          <p class="text-lg leading-snug text-muted-foreground">
            ChatGPT, Claude and Codex keep running. Porcelain is where they publish a walkthrough of the change, and
            where you comment back before you keep it.
          </p>
          <p class="mt-4 text-sm leading-snug text-muted-foreground">
            Browser and Mac, on Apple silicon. The iPhone and iPad app is still being built.
          </p>
        </div>
      </section>

      <figure id="walkthrough" class="animate-in slide-in-from-bottom-3 fill-mode-both delay-200 mt-12 scroll-mt-24 duration-700 lg:mt-16">
        <button
          type="button"
          class="block w-full cursor-zoom-in overflow-hidden rounded-xl bg-card text-left shadow-[inset_0_0_0_1px_var(--border)]"
          data-shot={walkthrough.src}
          data-alt="A decision in a published review, with its route through the code and a diff"
        >
          <img
            class="block w-full"
            src={walkthrough.src}
            width={walkthrough.width}
            height={walkthrough.height}
            alt="A decision in a published review, with its route through the code and a diff"
          />
        </button>
        <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-2 text-sm text-muted-foreground">
          <span>A decision, the route through the code, and the diff.</span>
          <span>Click a picture to see it larger.</span>
        </figcaption>
      </figure>

      <section class="mt-14 grid gap-10 border-t border-border pt-10 md:grid-cols-3 lg:mt-16" aria-label="The walkthrough">
        <div data-reveal>
          <h2 class="text-xl leading-tight font-medium tracking-[-0.03em]">One stop for each decision</h2>
          <p class="mt-3 text-muted-foreground">
            The agent publishes a briefing, then a stop for the decision. Numbered notes lead you to the files that
            matter, and the diff sits in the same view.
          </p>
        </div>
        <div data-reveal>
          <h2 class="text-xl leading-tight font-medium tracking-[-0.03em]">Not explained</h2>
          <p class="mt-3 text-muted-foreground">
            Changes the agent left out of the story stay visible. That stop links back to decisions that still contain
            those lines.
          </p>
        </div>
        <div data-reveal>
          <h2 class="text-xl leading-tight font-medium tracking-[-0.03em]">Reviewed</h2>
          <p class="mt-3 text-muted-foreground">
            Mark a file when you have read it. The review keeps track of what is left, so a long change does not become
            a pile of diffs.
          </p>
        </div>
      </section>

      <section id="comments" class="mt-28 scroll-mt-24 lg:mt-36">
        <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]" data-reveal>
          <h2 class="max-w-[14ch] text-[clamp(2rem,3.2vw,3.25rem)] leading-[1.02] font-medium tracking-[-0.04em]">
            Comment back before you keep it.
          </h2>
          <p class="max-w-xl text-lg leading-snug text-muted-foreground lg:pb-1">
            You write on the file. The agent replies in the same thread, over MCP, on your machine. The conversation
            stays with this change.
          </p>
        </div>
        <figure class="mt-8" data-reveal>
          <button
            type="button"
            class="block w-full cursor-zoom-in overflow-hidden rounded-xl bg-card text-left shadow-[inset_0_0_0_1px_var(--border)]"
            data-shot={comments.src}
            data-alt="A reviewer asks about the sample decision and the agent replies in the same thread"
          >
            <img
              class="block w-full"
              src={comments.src}
              width={comments.width}
              height={comments.height}
              alt="A reviewer asks about the sample decision and the agent replies in the same thread"
            />
          </button>
          <figcaption class="mt-3 text-sm text-muted-foreground">
            A file comment and a reply in the sample review.
          </figcaption>
        </figure>
      </section>

      <section id="proof" class="mt-28 scroll-mt-24 lg:mt-36">
        <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]" data-reveal>
          <h2 class="max-w-[14ch] text-[clamp(2rem,3.2vw,3.25rem)] leading-[1.02] font-medium tracking-[-0.04em]">
            See what was checked.
          </h2>
          <p class="max-w-xl text-lg leading-snug text-muted-foreground lg:pb-1">
            Readiness keeps the review in one place: files you have read, unexplained changes, comments, and checks.
            Proof opens the checks and the images the agent attached.
          </p>
        </div>
        <figure class="mt-8" data-reveal>
          <button
            type="button"
            class="block w-full cursor-zoom-in overflow-hidden rounded-xl bg-card text-left shadow-[inset_0_0_0_1px_var(--border)]"
            data-shot={proof.src}
            data-alt="Proof shows illustrative passing and failing checks, an image attachment and the readiness panel"
          >
            <img
              class="block w-full"
              src={proof.src}
              width={proof.width}
              height={proof.height}
              alt="Proof shows illustrative passing and failing checks, an image attachment and the readiness panel"
            />
          </button>
          <figcaption class="mt-3 text-sm text-muted-foreground">
            These sample results are not checks run on Porcelain itself.
          </figcaption>
        </figure>
      </section>

      <section class="mt-28 border-t border-border lg:mt-36" aria-label="More of the review">
        <div id="files" class="grid scroll-mt-24 gap-4 border-b border-border py-10 lg:grid-cols-[18rem_minmax(0,40rem)] lg:gap-16 lg:py-14" data-reveal>
          <h2 class="text-2xl leading-tight font-medium tracking-[-0.03em]">Pin what you are reading.</h2>
          <p class="text-lg leading-snug text-muted-foreground">
            Right-click a file and choose Pin file. It stays at the top of the tree until you choose Unpin file. Hide
            file, or Hide folder, takes it out of the list. The eye beside search shows what you hid.
          </p>
        </div>
        <div id="history" class="grid scroll-mt-24 gap-4 border-b border-border py-10 lg:grid-cols-[18rem_minmax(0,40rem)] lg:gap-16 lg:py-14" data-reveal>
          <h2 class="text-2xl leading-tight font-medium tracking-[-0.03em]">The commits, drawn as lanes.</h2>
          <p class="text-lg leading-snug text-muted-foreground">
            History is the repository's commit graph. Each commit sits on a lane, and a merge is drawn where branches
            meet, so you can see how the work arrived.
          </p>
        </div>
        <div id="remote" class="grid scroll-mt-24 gap-4 border-b border-border py-10 lg:grid-cols-[18rem_minmax(0,40rem)] lg:gap-16 lg:py-14" data-reveal>
          <h2 class="text-2xl leading-tight font-medium tracking-[-0.03em]">The repository stays where it is.</h2>
          <p class="text-lg leading-snug text-muted-foreground">
            On the computer that holds the repository, run porcelain pair and paste the link it prints. The browser or
            the Mac app keeps its own credential for that computer. The files are not copied across.
          </p>
        </div>
        <div id="source" class="grid scroll-mt-24 gap-4 py-10 lg:grid-cols-[18rem_minmax(0,40rem)] lg:gap-16 lg:py-14" data-reveal>
          <h2 class="text-2xl leading-tight font-medium tracking-[-0.03em]">Nothing to sign up for.</h2>
          <p class="text-lg leading-snug text-muted-foreground">
            There is no account. The review stays on your machine. Porcelain is open source, under the MIT license, and
            the source is the policy.
          </p>
        </div>
      </section>

      <section id="start" class="mt-8 scroll-mt-24 border-t border-border pt-16" data-reveal>
        <h2 class="max-w-[16ch] text-[clamp(2.4rem,4vw,4rem)] leading-[0.98] font-medium tracking-[-0.04em]">
          Start where the repository is.
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-snug text-muted-foreground">
          The server runs on the machine that holds your repositories. Open the address it prints.
        </p>
        <p class="mt-8 w-fit max-w-full overflow-x-auto rounded-lg bg-muted px-4 py-3 font-mono text-sm">
          <code>npx @fabiofiorita/porcelain@latest serve</code>
        </p>
        <p class="mt-8 max-w-md text-sm leading-snug text-muted-foreground">
          The pictures above use a disposable sample repository. The features, comments, and checks in them are
          illustrative.
        </p>
      </section>
    </main>

    <dialog
      id="shot"
      class="h-svh w-svw max-h-none max-w-none border-0 bg-transparent p-4 backdrop:bg-black/70 sm:p-8"
      aria-label="Screenshot"
    >
      <div class="flex h-full items-center justify-center">
        <button
          type="button"
          class="absolute top-4 right-4 z-10 rounded-full bg-foreground px-3 py-1.5 text-sm text-background"
        >
          Close
        </button>
        <img id="shot-image" class="max-h-full max-w-full rounded-lg" alt="" />
      </div>
    </dialog>

    <script>
      const dialog = document.querySelector('#shot');
      const shotImage = document.querySelector('#shot-image');
      const motion = ['animate-in', 'zoom-in-95', 'duration-300', 'fill-mode-both'];
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (dialog instanceof HTMLDialogElement && shotImage instanceof HTMLImageElement) {
        const open = (src: string, alt: string) => {
          shotImage.src = src;
          shotImage.alt = alt;
          shotImage.classList.remove(...motion);
          dialog.showModal();
          if (reduced()) return;
          void shotImage.offsetWidth;
          shotImage.classList.add(...motion);
        };

        for (const button of document.querySelectorAll('[data-shot]')) {
          if (!(button instanceof HTMLButtonElement)) continue;
          button.addEventListener('click', () => {
            const src = button.dataset.shot;
            const alt = button.dataset.alt;
            if (src && alt) open(src, alt);
          });
        }

        dialog.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('img')) return;
          dialog.close();
        });

        dialog.addEventListener('close', () => {
          shotImage.classList.remove(...motion);
        });
      }

      const revealed = document.querySelectorAll('[data-reveal]');
      if (!reduced() && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('animate-in', 'slide-in-from-bottom-6', 'duration-700', 'fill-mode-both');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.2 },
        );
        for (const node of revealed) observer.observe(node);
      }
    </script>
  </body>
</html>
