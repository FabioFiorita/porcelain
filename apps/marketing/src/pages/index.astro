---
import '../styles/global.css';

const description =
  'A companion for the coding agents you already run. They publish a walkthrough of what changed. You read it, comment, and decide what to keep.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#171717"
      media="(prefers-color-scheme: dark)"
    />
    <title>Porcelain</title>
  </head>
  <body
    class="bg-background text-foreground font-sans text-base leading-normal tracking-[-0.011em] antialiased"
  >
    <div class="mx-auto flex min-h-svh max-w-[1440px] flex-col px-5 py-6 lg:px-10">
      <header class="flex items-center justify-between gap-4">
        <div class="text-lg font-medium tracking-[-0.03em]">Porcelain</div>
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            class="inline-flex h-10 items-center gap-2 rounded-full px-3 text-sm text-muted-foreground no-underline hover:text-foreground"
            href="https://github.com/FabioFiorita/porcelain"
          >
            <svg viewBox="0 0 1024 1024" class="size-4" aria-hidden="true">
              <path
                fill="currentColor"
                fill-rule="evenodd"
                d="M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-128.64 23.68-161.92-31.36-172.16-60.16-5.76-14.72-30.72-60.16-52.48-72.32-17.92-9.6-43.52-33.28-.64-33.92 40.32-.64 69.12 37.12 78.72 52.48 46.08 77.44 119.68 55.68 149.12 42.24 4.48-33.28 17.92-55.68 32.64-68.48-113.92-12.8-232.96-56.96-232.96-252.8 0-55.68 19.84-101.76 52.48-137.6-5.12-12.8-23.04-65.28 5.12-135.68 0 0 42.88-13.44 140.8 52.48 40.96-11.52 84.48-17.28 128-17.28s87.04 5.76 128 17.28c97.92-66.56 140.8-52.48 140.8-52.48 28.16 70.4 10.24 122.88 5.12 135.68 32.64 35.84 52.48 81.28 52.48 137.6 0 196.48-119.68 240-233.6 252.8 18.56 16 34.56 46.72 34.56 94.72 0 68.48-.64 123.52-.64 140.8 0 13.44 9.6 29.44 35.2 24.32C877.44 929.92 1024 737.92 1024 512 1024 229.12 794.88 0 512 0"
                clip-rule="evenodd"></path>
            </svg>
            Source
          </a>
          <a
            class="inline-flex h-10 items-center gap-2 rounded-full bg-foreground px-4 text-sm text-background no-underline"
            href="https://github.com/FabioFiorita/porcelain/releases"
          >
            <svg viewBox="0 0 814 1000" class="size-4" aria-hidden="true">
              <path
                fill="currentColor"
                d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
              ></path>
            </svg>
            Download for Mac
          </a>
        </div>
      </header>

      <section class="mt-8 grid items-end gap-6 lg:grid-cols-[minmax(0,1fr)_auto]">
        <div>
          <h1
            class="max-w-[18ch] text-[clamp(2.75rem,4.4vw,4.25rem)] leading-[0.96] font-medium tracking-[-0.045em]"
          >
            Agents write the code. This is where you read it.
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-snug text-muted-foreground">
            ChatGPT, Claude and Codex keep running. Porcelain is where they
            publish a walkthrough of the change, and where you comment back
            before you keep it.
          </p>
        </div>
        <p class="max-w-xs text-sm leading-snug text-muted-foreground lg:pb-2 lg:text-right">
          Apple silicon today. Any browser. The iPhone and iPad app is still
          being built.
        </p>
      </section>

      <div
        class="mt-8 flex flex-wrap gap-2"
        role="tablist"
        aria-label="Parts of the review"
      >
        <button type="button" role="tab" data-scene="walkthrough" aria-selected="true" class="scene">Walkthrough</button>
        <button type="button" role="tab" data-scene="files" aria-selected="false" class="scene">Files</button>
        <button type="button" role="tab" data-scene="history" aria-selected="false" class="scene">History</button>
        <button type="button" role="tab" data-scene="comment" aria-selected="false" class="scene">Comment</button>
        <button type="button" role="tab" data-scene="remote" aria-selected="false" class="scene">Remote</button>
        <button type="button" role="tab" data-scene="source" aria-selected="false" class="scene">Open source</button>
      </div>
      <p id="coach" class="mt-3 min-h-12 max-w-3xl text-[15px] leading-snug text-muted-foreground"></p>

      <div
        class="mt-4 grid min-h-[680px] overflow-hidden rounded-xl border border-border bg-card shadow-2xl xl:grid-cols-[220px_minmax(0,1fr)_300px]"
      >
        <aside class="hidden border-border bg-background xl:block xl:border-r">
          <div class="flex items-center justify-between px-3 py-3 text-sm font-medium">
            Porcelain
          </div>
          <div class="px-3 pb-2 text-xs text-muted-foreground">repository</div>
          <div class="mx-2 rounded-md bg-accent px-2 py-1.5 text-sm">revoke-access</div>
          <div class="mt-3 px-3 text-xs text-muted-foreground">main</div>
        </aside>

        <div class="min-w-0 border-border xl:border-r">
          <div class="flex items-center gap-4 border-b border-border px-4 py-2.5 text-sm">
            <span class="font-medium">Review</span>
            <span class="text-muted-foreground">9 decisions</span>
            <span class="ml-auto text-muted-foreground">1 of 9 reviewed</span>
          </div>

          <div data-panel="walkthrough" class="px-4 py-4">
            <p class="text-xs font-medium tracking-wide text-muted-foreground">DECISION 2 OF 9</p>
            <h2 class="mt-1 text-xl font-medium tracking-[-0.03em]">Revoke access across devices</h2>
            <p class="mt-2 max-w-2xl text-sm leading-snug text-muted-foreground">
              Revocation goes through the session owner, so web and mobile observe the same invalidation event.
            </p>
            <ol class="mt-4 grid gap-2 sm:grid-cols-2">
              <li class="rounded-lg border border-border bg-background px-3 py-2 text-sm"><span class="mr-2 text-muted-foreground">1</span>Resolve from the device list</li>
              <li class="rounded-lg border border-border bg-background px-3 py-2 text-sm"><span class="mr-2 text-muted-foreground">2</span>Round the request</li>
              <li class="rounded-lg border border-border bg-background px-3 py-2 text-sm"><span class="mr-2 text-muted-foreground">3</span>Resolve through the session owner</li>
              <li class="rounded-lg border border-border bg-background px-3 py-2 text-sm"><span class="mr-2 text-muted-foreground">4</span>Keep the domain decision in its owner</li>
              <li class="rounded-lg border border-border bg-background px-3 py-2 text-sm"><span class="mr-2 text-muted-foreground">5</span>Prove the outcome and permission boundary</li>
              <li class="rounded-lg border border-border bg-background px-3 py-2 text-sm"><span class="mr-2 text-muted-foreground">6</span>Record the architectural decision</li>
            </ol>
            <pre class="mt-4 overflow-auto rounded-lg border border-border bg-background p-3 font-mono text-[12px] leading-5"><span class="text-muted-foreground">apps/web/src/revoke-access.ts</span>
<span class="block bg-graph-6/15">- export function handle(input) &#123;</span>
<span class="block bg-graph-2/15">+ export function submit(value: string) &#123;</span>
<span class="block">    return router(&#123; input, pending: true &#125;)</span>
<span class="block">  &#125;</span></pre>
            <p class="mt-3 text-sm text-muted-foreground">Not explained stays its own stop. A path-sorted diff would leave that work at the bottom of a long list.</p>
          </div>

          <div data-panel="history" class="hidden px-4 py-4" hidden>
            <h2 class="text-xl font-medium tracking-[-0.03em]">History</h2>
            <p class="mt-1 text-sm text-muted-foreground">The commit graph sits beside the commits.</p>
            <div class="mt-4 grid grid-cols-[72px_minmax(0,1fr)] gap-3">
              <svg viewBox="0 0 72 220" class="h-[220px] w-[72px] text-graph-1" aria-hidden="true">
                <path d="M24 16 V204" fill="none" stroke="currentColor" stroke-width="2"></path>
                <path d="M24 70 C24 104 48 104 48 138 V204" fill="none" class="text-graph-2" stroke="currentColor" stroke-width="2"></path>
                <circle cx="24" cy="28" r="5" fill="currentColor"></circle>
                <circle cx="24" cy="70" r="5" fill="currentColor"></circle>
                <circle cx="48" cy="138" r="5" class="text-graph-2" fill="currentColor"></circle>
                <circle cx="24" cy="176" r="5" fill="currentColor"></circle>
              </svg>
              <ol class="space-y-4 pt-1 text-sm">
                <li><span class="block font-medium">Record the architectural decision</span><span class="text-muted-foreground">main</span></li>
                <li><span class="block font-medium">Keep the domain decision in its owner</span><span class="text-muted-foreground">main</span></li>
                <li><span class="block font-medium">Prove the outcome</span><span class="text-graph-2">feature</span></li>
                <li><span class="block font-medium">Resolve through the session owner</span><span class="text-muted-foreground">main</span></li>
              </ol>
            </div>
          </div>

          <div data-panel="comment" class="hidden px-4 py-4" hidden>
            <h2 class="text-xl font-medium tracking-[-0.03em]">apps/web/src/revoke-access.ts</h2>
            <div class="mt-4 max-w-xl space-y-3">
              <div class="rounded-lg border border-border bg-background px-3 py-2.5">
                <div class="flex items-center gap-2 text-xs text-muted-foreground"><span class="font-medium text-foreground">You</span><span>just now</span></div>
                <p class="mt-1 text-sm">Can you explain how this decision reaches the other devices?</p>
              </div>
              <div class="rounded-lg border border-border bg-background px-3 py-2.5">
                <div class="flex items-center gap-2 text-xs text-muted-foreground"><span class="font-medium text-foreground">Agent</span><span>just now</span></div>
                <p class="mt-1 text-sm">The session owner publishes one revocation event. Web and mobile both observe it, so neither device keeps a session the other has ended.</p>
              </div>
            </div>
          </div>

          <div data-panel="remote" class="hidden px-4 py-4" hidden>
            <h2 class="text-xl font-medium tracking-[-0.03em]">Another computer</h2>
            <p class="mt-2 max-w-xl text-sm leading-snug text-muted-foreground">
              On the other computer, run porcelain pair and paste the link it prints. This app keeps its own credential for that computer. The repositories stay on the machine that holds them.
            </p>
            <form class="mt-4 flex max-w-xl gap-2">
              <input
                class="h-10 min-w-0 flex-1 rounded-md border border-border bg-background px-3 text-sm"
                aria-label="Pairing link"
                placeholder="The link the server prints"
                disabled
              />
              <button type="button" class="h-10 rounded-md bg-foreground px-3 text-sm text-background" disabled>Add</button>
            </form>
            <p class="mt-2 text-xs text-muted-foreground">This model does not pair. The real review runs on your machine.</p>
          </div>

          <div data-panel="source" class="hidden px-4 py-4" hidden>
            <h2 class="text-xl font-medium tracking-[-0.03em]">Open source</h2>
            <p class="mt-2 max-w-xl text-sm leading-snug text-muted-foreground">
              Porcelain is MIT. The review stays on your machine. There is no account, and there is nothing of yours to disclose. If you do not trust that, read the source. That is the policy.
            </p>
            <p class="mt-4 text-sm">
              <a class="text-foreground underline" href="https://github.com/FabioFiorita/porcelain">github.com/FabioFiorita/porcelain</a>
            </p>
            <p class="mt-6 text-sm leading-snug text-muted-foreground">
              The iPhone and iPad app is in this repository. It appears here when you can hold it.
            </p>
          </div>

          <div data-panel="files" class="hidden px-4 py-4" hidden>
            <h2 class="text-xl font-medium tracking-[-0.03em]">Files</h2>
            <p class="mt-2 max-w-xl text-sm leading-snug text-muted-foreground">Right-click a file in the list. Pin keeps it at the top. Hide takes it out of the way until you show it again.</p>
          </div>
        </div>

        <aside id="files-pane" class="bg-background">
          <div class="flex items-center justify-between border-b border-border px-3 py-2.5 text-sm">
            <span class="font-medium">Files</span>
            <button type="button" id="show-hidden" class="hidden text-xs text-muted-foreground underline" hidden>Show hidden</button>
          </div>
          <div id="pinned-block" class="hidden border-b border-border px-2 py-2" hidden>
            <p class="px-1.5 pb-1 text-xs text-muted-foreground">Pinned</p>
            <ul id="pinned-list" class="space-y-0.5"></ul>
          </div>
          <p class="px-3.5 pt-2 pb-1 text-xs text-muted-foreground">All files</p>
          <ul id="file-list" class="space-y-0.5 px-2 pb-3">
            <li data-path="apps/web/src/revoke-access.ts"><button type="button" class="file">apps/web/src/revoke-access.ts</button></li>
            <li data-path="apps/server/src/revoke-access.ts"><button type="button" class="file">apps/server/src/revoke-access.ts</button></li>
            <li data-path="packages/workspace/src/session-owner.ts"><button type="button" class="file">packages/workspace/src/session-owner.ts</button></li>
            <li data-path="packages/access/src/policy.ts"><button type="button" class="file">packages/access/src/policy.ts</button></li>
            <li data-path="docs/README.md"><button type="button" class="file">docs/README.md</button></li>
          </ul>
        </aside>
      </div>

      <div
        id="menu"
        role="menu"
        hidden
        class="fixed z-30 hidden min-w-40 rounded-lg border border-border bg-popover p-1 text-sm text-popover-foreground shadow-md"
      >
        <button type="button" role="menuitem" data-act="pin" class="block w-full rounded-md px-2 py-1.5 text-left hover:bg-accent">Pin file</button>
        <button type="button" role="menuitem" data-act="hide" class="block w-full rounded-md px-2 py-1.5 text-left hover:bg-accent">Hide file</button>
      </div>

      <section id="start" class="mt-10 grid gap-6 border-t border-border pt-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div>
          <h2 class="text-2xl font-medium tracking-[-0.03em]">On the machine that holds the repositories.</h2>
          <pre class="mt-3 overflow-auto rounded-lg border border-border bg-card px-4 py-3 font-mono text-sm">npx @fabiofiorita/porcelain@latest serve</pre>
          <p class="mt-2 text-sm text-muted-foreground">Pair the browser with the link it prints, then open the repository.</p>
        </div>
        <p class="text-sm text-muted-foreground">One server. Your agents. Your machine. MIT.</p>
      </section>
    </div>

    <style>
      .scene {
        height: 2.25rem;
        border-radius: 999px;
        padding-inline: 0.9rem;
        font-size: 0.875rem;
        color: var(--muted-foreground);
        background: transparent;
      }
      .scene[aria-selected='true'] {
        color: var(--background);
        background: var(--foreground);
      }
      .file {
        display: block;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        border-radius: 0.375rem;
        padding: 0.3rem 0.4rem;
        text-align: left;
        font-family: var(--font-mono);
        font-size: 12px;
      }
      .file:hover,
      .file[aria-current='true'] {
        background: var(--accent);
      }
      #files-pane[data-focus='true'] {
        box-shadow: inset 0 0 0 2px var(--foreground);
      }
    </style>

    <script>
      const coach = document.querySelector('#coach');
      const menu = document.querySelector('#menu');
      const pinLabel = menu.querySelector('[data-act="pin"]');
      const hideLabel = menu.querySelector('[data-act="hide"]');
      const fileList = document.querySelector('#file-list');
      const pinnedList = document.querySelector('#pinned-list');
      const pinnedBlock = document.querySelector('#pinned-block');
      const showHidden = document.querySelector('#show-hidden');
      const filesPane = document.querySelector('#files-pane');
      const lines = {
        walkthrough:
          'One decision, the route it takes, and the diff under the note that explains it. Changed lines the story left out stay visible as Not explained.',
        files:
          'Right-click a file. Pin the ones you return to. Hide the ones that bury a large repository. They stay that way in the real review.',
        history:
          'History draws the commit graph beside the commits, so you can see how the branch arrived.',
        comment:
          'You write on the file. The reply comes back in the same thread, through MCP, on your machine. The agent stays in the app you already pay for.',
        remote:
          'Pair another computer with the link the server prints. You open the same review from where you are sitting. The repositories do not move.',
        source:
          'Porcelain is open source. The review stays on your machine. There is no account and nothing of yours to disclose. If you do not trust that, read the source.',
      };
      let scene = 'walkthrough';
      let target = null;

      const showScene = (next) => {
        scene = next;
        coach.textContent = lines[next];
        for (const tab of document.querySelectorAll('[data-scene]'))
          tab.setAttribute('aria-selected', String(tab.dataset.scene === next));
        for (const panel of document.querySelectorAll('[data-panel]')) {
          const visible = panel.dataset.panel === next;
          panel.hidden = !visible;
          panel.classList.toggle('hidden', !visible);
        }
        filesPane.dataset.focus = next === 'files' ? 'true' : 'false';
      };

      const row = (path) => document.querySelector(`[data-path="${path}"]`);
      const nameOf = (path) => path.split('/').slice(-3).join('/');

      const paint = () => {
        const rows = [...fileList.querySelectorAll('[data-path]'), ...pinnedList.querySelectorAll('[data-path]')];
        let hiddenCount = 0;
        let pinnedCount = 0;
        for (const item of rows) {
          const pinned = item.dataset.pinned === 'true';
          const hidden = item.dataset.hidden === 'true';
          if (hidden) hiddenCount += 1;
          if (pinned) pinnedCount += 1;
          const home = pinned ? pinnedList : fileList;
          if (item.parentElement !== home) home.append(item);
          item.hidden = hidden;
          const button = item.querySelector('button');
          button.textContent = nameOf(item.dataset.path);
        }
        pinnedBlock.hidden = pinnedCount === 0;
        pinnedBlock.classList.toggle('hidden', pinnedCount === 0);
        showHidden.hidden = hiddenCount === 0;
        showHidden.classList.toggle('hidden', hiddenCount === 0);
        showHidden.textContent = hiddenCount === 1 ? 'Show 1 hidden' : `Show ${hiddenCount} hidden`;
      };

      const closeMenu = () => {
        menu.hidden = true;
        menu.classList.add('hidden');
        target = null;
      };

      const openMenu = (event, path) => {
        event.preventDefault();
        target = path;
        const item = row(path);
        pinLabel.textContent = item.dataset.pinned === 'true' ? 'Unpin file' : 'Pin file';
        hideLabel.textContent = 'Hide file';
        menu.hidden = false;
        menu.classList.remove('hidden');
        const width = 180;
        const left = Math.min(event.clientX, window.innerWidth - width - 8);
        const top = Math.min(event.clientY, window.innerHeight - 88);
        menu.style.left = `${left}px`;
        menu.style.top = `${top}px`;
      };

      document.querySelectorAll('[data-path] button').forEach((button) => {
        const path = button.parentElement.dataset.path;
        button.addEventListener('contextmenu', (event) => openMenu(event, path));
      });

      menu.addEventListener('click', (event) => {
        const act = event.target.closest('[data-act]')?.dataset.act;
        if (!act || !target) return;
        const item = row(target);
        if (act === 'pin') {
          item.dataset.pinned = item.dataset.pinned === 'true' ? 'false' : 'true';
          coach.textContent =
            item.dataset.pinned === 'true'
              ? 'Pinned. It stays at the top while the rest of a large repository scrolls past.'
              : 'Unpinned. It returns to the file list.';
        }
        if (act === 'hide') {
          item.dataset.hidden = 'true';
          item.dataset.pinned = 'false';
          coach.textContent = 'Hidden. Show hidden brings it back. The review no longer has to wade through it.';
        }
        paint();
        closeMenu();
      });

      showHidden.addEventListener('click', () => {
        for (const item of document.querySelectorAll('[data-path]')) item.dataset.hidden = 'false';
        paint();
        coach.textContent = 'The hidden files are back in the list.';
      });

      document.addEventListener('click', (event) => {
        if (!menu.contains(event.target)) closeMenu();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
      window.addEventListener('resize', () => showScene(scene));

      for (const tab of document.querySelectorAll('[data-scene]'))
        tab.addEventListener('click', () => showScene(tab.dataset.scene));

      showScene('walkthrough');
      paint();
    </script>
  </body>
</html>
