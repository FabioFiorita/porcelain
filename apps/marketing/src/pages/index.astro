  </main>

  <script>
    import { animate, inView, scroll, stagger } from 'motion';

    type Region = readonly [number, number, number, number];
    interface Stop {
      readonly shot: number;
      readonly region: Region;
      readonly title: string;
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const spring = { type: 'spring', stiffness: 120, damping: 22, mass: 0.9 } as const;
    const all = <T extends Element = HTMLElement>(selector: string, root: ParentNode = document) =>
      Array.from(root.querySelectorAll<T & Element>(selector)) as T[];
    const one = <T extends Element = HTMLElement>(selector: string, root: ParentNode = document) =>
      root.querySelector(selector) as T | null;
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    /* Runs a demo while its element is in view. Leaving ends that run, so coming back never stacks a second loop. */
    function whileVisible(element: Element, amount: number, play: (live: () => boolean) => Promise<void>) {
      let generation = 0;
      inView(
        element,
        () => {
          const run = ++generation;
          void play(() => run === generation);
          return () => {
            generation += 1;
          };
        },
        { amount },
      );
    }

    /* The glows drift behind the hero and the closing panel. */
    function drift() {
      for (const [index, glow] of all('[data-glow]').entries()) {
        animate(
          glow,
          { x: [0, index % 2 ? -60 : 70, 0], y: [0, index % 2 ? 40 : -30, 0], scale: [1, 1.12, 1] },
          { duration: 14 + index * 3, repeat: Infinity, ease: 'easeInOut' },
        );
      }
    }

    /* The hero picture lies back and stands up as the page scrolls, then its numbered notes point at it. */
    function stageHero() {
      const frame = one('[data-hero-frame]');
      const tilt = one('[data-hero-tilt]');
      if (!frame || !tilt) return;

      animate(frame, { opacity: [0, 1], y: [80, 0] }, { duration: 1.2, delay: 0.45, ease: [0.22, 1, 0.36, 1] });
      scroll(animate(tilt, { rotateX: [24, 0], scale: [0.9, 1], y: [-30, 0] }, { ease: 'linear' }), {
        target: frame,
        offset: ['start end', 'start 0.18'],
      });

      const callouts = all('[data-callout]');
      animate(callouts, { opacity: [0, 1], x: [-8, 0] }, { delay: stagger(0.18, { startDelay: 1.4 }), duration: 0.6 });
      animate(
        all('[data-callout-line]'),
        { scaleX: [0, 1] },
        { delay: stagger(0.18, { startDelay: 1.55 }), duration: 0.7, ease: [0.22, 1, 0.36, 1] },
      );
    }

    /* An alphabetical diff: forty-one files in, attention drains row by row and runs out around the decision. */
    function drainAttention() {
      const list = one('[data-diff-list]');
      const scan = one('[data-scan]');
      const meter = one('[data-attention]');
      const matters = one('[data-matters]');
      const decision = one('[data-diff-row="decision"]');
      if (!list || !scan || !meter || !matters || !decision) return;
      const rows = all('[data-diff-row]', list);
      const attention = (left: number) => ({
        width: `${Math.max(left * 30, 3)}%`,
        backgroundColor: left > 0.5 ? 'var(--graph-4)' : 'var(--destructive)',
      });

      whileVisible(list, 0.5, async (live) => {
        while (live()) {
          animate(rows, { opacity: 1, x: 0 }, { duration: 0.3 });
          animate(matters, { opacity: 0 }, { duration: 0.2 });
          animate(meter, attention(1), { duration: 0.4 });
          await animate(scan, { y: 0, opacity: 1 }, { duration: 0.4 });
          for (const [index, row] of rows.entries()) {
            if (!live()) return;
            animate(meter, attention(1 - (index + 1) / rows.length));
            await animate(scan, { y: row.offsetTop }, { duration: 0.32, ease: 'easeInOut' });
            if (row === decision) {
              animate(matters, { opacity: [0, 1], scale: [0.8, 1] }, spring);
              animate(row, { x: [0, -3, 3, -2, 0] }, { duration: 0.4 });
            } else {
              animate(row, { opacity: 0.35 }, { duration: 0.4 });
            }
          }
          await wait(2600);
        }
      });
    }

    /* Packets travel between the agent, Porcelain, and you. */
    function sendPackets() {
      for (const [index, carrier] of all('[data-packet]').entries()) {
        const toRight = carrier.dataset.packet === 'right';
        animate(
          carrier,
          { x: toRight ? ['0%', '100%'] : ['100%', '0%'], opacity: [0, 1, 1, 0] },
          { duration: 2.2, repeat: Infinity, ease: 'easeInOut', delay: index * 0.55, repeatDelay: 0.6 },
        );
      }
    }

    /* The tour holds the picture still and moves a camera across it, one stop at a time. */
    function runTour() {
      const tour = one('[data-tour]');
      const data = one('#tour-stops');
      const spotlight = one('[data-spotlight]');
      const label = one('[data-spotlight-label]');
      const number = one('[data-spotlight-number]');
      const title = one('[data-spotlight-title]');
      if (!tour || !data?.textContent || !spotlight || !label || !number || !title) return;
      const stops = JSON.parse(data.textContent) as Stop[];
      const cameras = all('[data-camera]', tour);
      const copies = all('[data-stop-copy]', tour);
      const desktop = window.matchMedia('(min-width: 64rem)');

      const progress = one('[data-tour-progress]', tour);
      if (progress) {
        scroll(animate(progress, { scaleY: [0, 1] }, { ease: 'linear' }), {
          target: tour,
          offset: ['start 0.5', 'end 0.5'],
        });
      }

      let current = -1;
      const show = (index: number) => {
        if (index === current || !desktop.matches) return;
        current = index;
        const stop = stops[index];
        if (!stop) return;
        const [left, top, right, bottom] = stop.region;
        const width = right - left;
        const height = bottom - top;
        const zoom = Math.min(Math.max(Math.min(1 / width, 1 / height) / 1.12, 1), 2.4);
        const centerX = left + width / 2;
        const centerY = top + height / 2;
        const x = Math.min(Math.max(0.5 - centerX * zoom, 1 - zoom), 0);
        const y = Math.min(Math.max(0.5 - centerY * zoom, 1 - zoom), 0);
        const options = reduced ? { duration: 0 } : spring;

        for (const [shot, camera] of cameras.entries()) {
          const active = shot === stop.shot;
          animate(camera, { opacity: active ? 1 : 0 }, reduced ? { duration: 0 } : { duration: 0.45 });
          if (active) animate(camera, { x: `${x * 100}%`, y: `${y * 100}%`, scale: zoom }, options);
        }
        animate(
          spotlight,
          {
            left: `${(x + left * zoom) * 100}%`,
            top: `${(y + top * zoom) * 100}%`,
            width: `${width * zoom * 100}%`,
            height: `${height * zoom * 100}%`,
            opacity: 1,
          },
          options,
        );
        number.textContent = String(index + 1);
        title.textContent = stop.title;
        animate(label, { opacity: [0, 1], y: [-6, 0] }, reduced ? { duration: 0 } : { duration: 0.35 });
        for (const [copyIndex, copy] of copies.entries()) copy.style.opacity = copyIndex === index ? '1' : '';
      };

      for (const element of all('[data-stop]', tour)) {
        inView(
          element,
          () => {
            show(Number(element.dataset.stop));
            return () => {};
          },
          { margin: '-45% 0px -45% 0px' },
        );
      }
    }

    /* History draws its lanes, then drops each commit onto them. */
    function drawHistory() {
      const graph = one<SVGSVGElement>('[data-graph]');
      if (!graph) return;
      const lanes = all<SVGPathElement>('[data-lane]', graph);
      const commits = all<SVGCircleElement>('[data-commit]', graph);
      for (const lane of lanes) {
        const length = lane.getTotalLength();
        lane.style.strokeDasharray = `${length}`;
        lane.style.strokeDashoffset = `${length}`;
      }
      for (const commit of commits) commit.style.opacity = '0';

      inView(
        graph,
        () => {
          animate(lanes, { strokeDashoffset: 0 }, { duration: 1.4, delay: stagger(0.35), ease: [0.65, 0, 0.35, 1] });
          animate(
            commits,
            { opacity: [0, 1], scale: [0, 1] },
            { ...spring, delay: stagger(0.12, { startDelay: 0.5 }) },
          );
        },
        { amount: 0.5 },
      );
    }

    /* Files: the context menu pins a file to the top, then hides a folder. */
    function pinAndHide() {
      const tree = one('[data-tree]');
      if (!tree) return;
      const pinned = one('[data-pinned]', tree);
      const pinnedRow = one('[data-pinned-row]', tree);
      const pinRow = one('[data-tree-row="pin"]', tree);
      const hideRow = one('[data-tree-row="hide"]', tree);
      const menu = one('[data-menu]', tree);
      const action = one('[data-menu-action]', tree);
      const chip = one('[data-hidden-chip]', tree);
      if (!pinned || !pinnedRow || !pinRow || !hideRow || !menu || !action || !chip) return;

      const rowHeight = 32;
      const pinnedHeight = pinned.scrollHeight;
      const instant = { duration: 0 };

      const reset = () => {
        animate(menu, { opacity: 0 }, instant);
        animate([pinned, chip], { opacity: 0 }, instant);
        animate(pinned, { height: 0 }, instant);
        animate(pinnedRow, { y: 0 }, instant);
        animate([pinRow, hideRow], { height: rowHeight, opacity: 1, backgroundColor: 'rgba(0, 0, 0, 0)' }, instant);
      };

      const openMenu = async (row: HTMLElement, label: string) => {
        action.textContent = label;
        animate(row, { backgroundColor: 'var(--accent)' }, { duration: 0.2 });
        menu.style.top = `${row.offsetTop + rowHeight - 4}px`;
        await animate(menu, { opacity: [0, 1], scale: [0.94, 1], y: [-4, 0] }, { duration: 0.2 });
        await wait(650);
        await animate(action, { scale: [1, 0.96, 1] }, { duration: 0.18 });
        await animate(menu, { opacity: 0, scale: 0.97 }, { duration: 0.15 });
      };

      whileVisible(tree, 0.6, async (live) => {
        while (live()) {
          reset();
          animate(pinned, { opacity: 1 }, instant);
          await wait(700);
          if (!live()) return;
          await openMenu(pinRow, 'Pin file');
          if (!live()) return;
          const travel = pinRow.offsetTop - pinnedRow.offsetTop;
          animate(pinned, { height: [0, pinnedHeight] }, spring);
          animate(pinRow, { height: 0, opacity: 0 }, spring);
          await animate(pinnedRow, { y: [travel, 0], opacity: [0.4, 1] }, spring);
          await wait(900);
          if (!live()) return;
          await openMenu(hideRow, 'Hide folder');
          if (!live()) return;
          animate(hideRow, { height: 0, opacity: 0 }, spring);
          await animate(chip, { opacity: [0, 1], scale: [0.8, 1] }, spring);
          await wait(2600);
          if (!live()) return;
          await animate([pinned, chip, pinRow, hideRow], { opacity: 0 }, { duration: 0.3 });
        }
      });
    }

    /* Remote: data runs along the wires to each machine. Mobile: a shimmer stands in for the app. */
    function ambient() {
      for (const [index, wire] of all<SVGPathElement>('[data-wire]').entries()) {
        animate(wire, { strokeDashoffset: [0, -40] }, { duration: 1.6, repeat: Infinity, ease: 'linear', delay: index * 0.2 });
      }
      for (const mark of all('[data-float]')) {
        animate(mark, { y: [0, -14, 0], rotate: [-2, 2, -2] }, { duration: 7, repeat: Infinity, ease: 'easeInOut' });
      }
      for (const shimmer of all('[data-shimmer]')) {
        animate(
          shimmer,
          { backgroundPosition: ['100% 0%', '-50% 0%'] },
          { duration: 2.4, repeat: Infinity, ease: 'easeInOut', repeatDelay: 0.6 },
        );
      }
    }

    if (reduced) {
      runTour();
    } else {
      drift();
      stageHero();
      drainAttention();
      sendPackets();
      runTour();
      drawHistory();
      pinAndHide();
      ambient();
    }
  </script>
</Site>
