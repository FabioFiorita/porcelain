        <div class="pointer-events-none absolute top-1/2 right-[8%] hidden -translate-y-1/2 lg:block" aria-hidden="true">
          <div class="absolute inset-6 rounded-[3rem] bg-graph-1/50 blur-[70px]"></div>
          <img data-float src={icon.src} width={icon.width} height={icon.height} alt="" class="relative size-64 rounded-[3.5rem] shadow-[0_40px_80px_-20px_rgb(0_0_0/0.6)] xl:size-80" />
