---
import Site from '../layouts/site.astro';
import Command from '../components/command.astro';
import ComingSoon from '../components/coming-soon.astro';
import GithubMark from '../components/github-mark.astro';
import walkthrough from '../assets/walkthrough.png';
import comments from '../assets/comments.png';
import proof from '../assets/proof.png';
import icon from '../../../../apps/web/public/icon-512.png';

const description =
  'A diff does not tell you what changed. The agent that wrote it can. In Porcelain, it walks you through each decision, and you comment back before you keep the change.';
const serve = 'npx @fabiofiorita/porcelain@latest serve';
const github = 'https://github.com/FabioFiorita/porcelain';

const headline = [
  { words: ['Agents', 'write', 'the', 'code.'], tone: 'text-muted-foreground' },
  { words: ['This', 'is', 'where', 'you', 'read', 'it.'], tone: 'text-foreground' },
];

/* Points on the walkthrough picture, as fractions of its width and height. */
const callouts = [
  { n: 1, label: 'One stop per decision', side: 'left', y: 0.229, x: 0.198 },
  { n: 2, label: 'The route through your code', side: 'left', y: 0.312, x: 0.198 },
  { n: 3, label: 'Notes that lead to the files', side: 'right', y: 0.448, x: 0.755 },
  { n: 4, label: 'The diff, in the same view', side: 'right', y: 0.79, x: 0.766 },
] as const;

const shots = [
  { image: walkthrough, alt: 'A decision in a published review, with its route through the code and a diff' },
  { image: comments, alt: 'A reviewer asks about a file and the agent replies in the same thread' },
  { image: proof, alt: 'Proof with passing checks, a web and an iPhone screenshot, beside the readiness of the review' },
] as const;

/* Each stop of the tour frames one region of one picture: [left, top, right, bottom]. */
const stops = [
  {
    id: 'walkthrough',
    shot: 0,
    region: [0.2, 0.18, 0.7, 0.37],
    title: 'One stop for each decision',
    body: 'The agent publishes a briefing, then a stop for every decision it made. Each stop says what it decided and the route it took through your code.',
  },
  {
    id: 'notes',
    shot: 0,
    region: [0.2, 0.375, 0.76, 0.685],
    title: 'Notes lead you to the files',
    body: 'Numbered notes point at the files that carry the decision, in the order to read them, and say which layer each one touches.',
  },
  {
    id: 'diff',
    shot: 0,
    region: [0.195, 0.712, 0.767, 1],
    title: 'The diff stays in the same view',
    body: 'You read the explanation and the change together. Mark a file reviewed when you are done with it, and the review keeps count.',
  },
  {
    id: 'comments',
    shot: 1,
    region: [0.226, 0.205, 0.762, 0.46],
    title: 'Comment back on the code',
    body: 'Ask on a file or a line. Any agent that speaks MCP answers in the same thread, and the conversation stays with the change.',
  },
  {
    id: 'readiness',
    shot: 2,
    region: [0.776, 0.13, 0.99, 0.69],
    title: 'See what is left',
    body: 'Readiness counts what still needs you: files to read, lines the agent never explained, comments waiting on you or on the agent.',
  },
  {
    id: 'proof',
    shot: 2,
    region: [0.2, 0.52, 0.745, 0.92],
    title: 'Proof you can look at',
    body: 'The checks the agent ran and the screenshots it took, on the web and on a phone, live in the review next to the code.',
  },
  {
    id: 'stale',
    shot: 2,
    region: [0.2, 0.1, 0.745, 0.52],
    title: 'And when it went stale',
    body: 'When the code changes after the checks ran, Porcelain says so, and asks the agent to run them again.',
  },
] as const;

/* On a phone each stop shows only its region of the picture, cropped to the same frame the desktop camera finds. */
const crop = (shot: number, [left, top, right, bottom]: readonly [number, number, number, number]) => {
  const { width, height } = shots[shot]!.image;
  const regionWidth = right - left;
  const regionHeight = bottom - top;
  return {
    frame: `aspect-ratio: ${(regionWidth * width) / (regionHeight * height)}`,
    image: `width: ${100 / regionWidth}%; left: ${(-left / regionWidth) * 100}%; top: ${(-top / regionHeight) * 100}%`,
  };
};

const problems = [
  {
    title: 'A diff has no order',
    body: 'Files arrive by name. A test weighs as much as the decision it proves, and the change you needed to see is the one you skim.',
  },
  {
    title: 'Editors are built for typing',
    body: 'You read code now more than you write it. An editor full of extensions and autocomplete is heavy for that, and it was never made to review.',
  },
  {
    title: 'The conversation is somewhere else',
    body: 'Your question lands in a chat window, far from the line that raised it. The answer comes back without the code you were looking at.',
  },
] as const;

/* The last fourteen of the fifty-five files, by name. The decision is the eighth of them. */
const changedFiles = [
  'packages/client/src/request.ts',
  'packages/client/src/revoke-access.ts',
  'packages/client/src/session.ts',
  'packages/workspace/src/actor.ts',
  'packages/workspace/src/journal.ts',
  'packages/workspace/src/policy.ts',
  'packages/workspace/src/revoke-access.ts',
  'packages/workspace/src/sessions.ts',
  'scripts/seed-devices.ts',
  'tests/fixtures/devices.json',
  'tests/journal.spec.ts',
  'tests/policy.spec.ts',
  'tests/revoke-access.spec.ts',
  'tests/sessions.spec.ts',
] as const;
const decisionFile = 'packages/workspace/src/sessions.ts';
const filesAbove = 55 - changedFiles.length;

const treeRows = [
  { name: 'apps', kind: 'folder', depth: 0 },
  { name: 'server', kind: 'folder', depth: 1 },
  { name: 'revoke-access.ts', kind: 'file', depth: 2, role: 'pin' },
  { name: 'routes.ts', kind: 'file', depth: 2 },
  { name: 'web', kind: 'folder', depth: 1 },
  { name: 'fixtures', kind: 'folder', depth: 0, role: 'hide' },
  { name: 'packages', kind: 'folder', depth: 0 },
  { name: 'README.md', kind: 'file', depth: 0 },
] as const;
---

<Site description={description}>
  <main id="top" class="overflow-x-clip">
    <!-- Hero -->
    <section class="relative isolate">
      <div
        class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
        aria-hidden="true"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:64px_64px] opacity-70"
        >
        </div>
        <div data-glow class="absolute top-[-12rem] left-[12%] size-[38rem] rounded-full bg-graph-1/20 blur-[120px]"></div>
        <div data-glow class="absolute top-[-6rem] right-[8%] size-[30rem] rounded-full bg-graph-3/15 blur-[120px]"></div>
      </div>

      <div class="mx-auto max-w-[1440px] px-5 pt-14 lg:px-10 lg:pt-24">
        <a
          href={github}
          data-reveal
          class="group inline-flex items-center gap-2 rounded-full border border-border bg-background/70 py-1 pr-3 pl-1 text-sm text-muted-foreground no-underline backdrop-blur transition-colors hover:text-foreground"
        >
          <span class="rounded-full bg-foreground px-2 py-0.5 text-xs font-medium whitespace-nowrap text-background">Open source</span>
          Works with any agent that speaks MCP
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>

        <h1
          class="mt-7 max-w-[16ch] text-[clamp(3rem,7.4vw,7.25rem)] leading-[0.92] font-semibold tracking-[-0.055em] lg:max-w-none"
        >
          {
            headline.map((line) => (
              <span class:list={['block', line.tone]}>
                {line.words.map((word) => (
                  <>
                    <span data-word class="inline-block">
                      {word}
                    </span>{' '}
                  </>
                ))}
              </span>
            ))
          }
        </h1>

        <div class="mt-9 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,42rem)_auto] lg:items-end lg:justify-between">
          <p data-reveal class="text-lg leading-relaxed text-muted-foreground lg:text-xl lg:leading-relaxed">
            A diff does not tell you what changed. The agent that wrote it can. In Porcelain, it walks you through each
            decision, and you comment back before you keep the change.
          </p>

          <div data-reveal class="flex min-w-0 flex-col items-start gap-4 lg:items-end">
            <div class="flex max-w-full flex-wrap items-center gap-3">
              <a
                class="inline-flex h-11 items-center gap-2 rounded-full bg-foreground px-5 text-sm font-medium text-background no-underline transition-transform hover:scale-[1.03] active:scale-[0.98]"
                href="/install"
              >
                Download
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"></path>
                </svg>
              </a>
              <Command command={serve} />
            </div>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground">
              <span>Mac app</span>
              <span class="text-border" aria-hidden="true">/</span>
              <span>Browser</span>
              <span class="text-border" aria-hidden="true">/</span>
              <span class="inline-flex items-center gap-2">Mobile app <ComingSoon /></span>
            </p>
          </div>
        </div>
      </div>

      <div class="mx-auto mt-16 max-w-[1440px] px-5 lg:mt-20 lg:px-10">
        <div data-hero-frame class="relative [perspective:2000px]">
          <div data-hero-tilt class="relative origin-top">
            <div
              class="pointer-events-none absolute inset-x-[8%] -top-10 -z-10 h-2/3 rounded-full bg-graph-1/25 blur-[100px]"
              aria-hidden="true"
            >
            </div>
            <div class="rounded-[1.4rem] bg-muted/80 p-1.5 shadow-[inset_0_0_0_1px_var(--border),0_40px_120px_-40px_rgb(0_0_0/0.35)] backdrop-blur lg:p-2">
              <div class="relative overflow-hidden rounded-2xl shadow-[0_0_0_1px_var(--border)]">
                <img
                  class="block w-full"
                  src={walkthrough.src}
                  width={walkthrough.width}
                  height={walkthrough.height}
                  alt={shots[0].alt}
                  fetchpriority="high"
                />
                {
                  callouts.map((callout) => (
                    <div
                      data-callout
                      class="absolute hidden -translate-y-1/2 items-center xl:flex"
                      style={
                        callout.side === 'left'
                          ? `left: 1.4%; right: ${100 - callout.x * 100}%; top: ${callout.y * 100}%`
                          : `left: ${callout.x * 100}%; right: 1.4%; top: ${callout.y * 100}%`
                      }
                    >
                      {callout.side === 'right' && (
                        <span data-callout-line class="h-px flex-1 origin-left bg-graph-1/70" />
                      )}
                      <span class="inline-flex shrink-0 items-center gap-2 rounded-full bg-popover py-1 pr-3 pl-1 text-[0.8rem] font-medium whitespace-nowrap text-popover-foreground shadow-[0_0_0_1px_var(--border),0_8px_24px_-8px_rgb(0_0_0/0.25)]">
                        <span class="inline-flex size-5 items-center justify-center rounded-full bg-graph-1/15 text-[0.7rem] font-semibold text-graph-1">
                          {callout.n}
                        </span>
                        {callout.label}
                      </span>
                      {callout.side === 'left' && (
                        <span data-callout-line class="h-px flex-1 origin-right bg-graph-1/70" />
                      )}
                      <span
                        class:list={[
                          'absolute size-2.5 rounded-full bg-graph-1 ring-4 ring-graph-1/20',
                          callout.side === 'left' ? '-right-1' : '-left-1',
                        ]}
                      />
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The problem -->
    <section class="mx-auto max-w-[1440px] px-5 pt-32 lg:px-10 lg:pt-48">
      <div class="grid grid-cols-1 gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)] lg:gap-20">
        <div>
          <p data-reveal class="font-mono text-xs tracking-[0.18em] text-muted-foreground uppercase">Why it exists</p>
          <h2
            data-reveal
            class="mt-5 text-[clamp(2.4rem,4.6vw,4.5rem)] leading-[0.98] font-semibold tracking-[-0.05em]"
          >
            Fifty-five files, sorted by name.{' '}
            <span class="text-muted-foreground">The one that matters is near the bottom.</span>
          </h2>
          <p data-reveal class="mt-7 max-w-xl text-lg leading-relaxed text-muted-foreground">
            An agent can change more code in ten minutes than you can read in an hour. The review tools you have list it
            alphabetically, and your attention runs out before the decision does.
          </p>
        </div>

        <div data-reveal data-diff-list class="relative self-center rounded-2xl border border-border bg-card p-2 shadow-[0_30px_80px_-50px_rgb(0_0_0/0.35)]">
          <div class="flex items-center justify-between px-3 pt-2 pb-3 text-xs text-muted-foreground">
            <span class="font-mono">55 changed files · by name</span>
            <span class="flex items-center gap-2">
              Attention
              <span class="relative h-1.5 w-20 overflow-hidden rounded-full bg-muted">
                <span data-attention class="absolute inset-y-0 left-0 w-[30%] rounded-full bg-graph-4"></span>
              </span>
            </span>
          </div>
          <div class="px-3 pb-1 font-mono text-xs text-muted-foreground/70">+ {filesAbove} files above</div>
          <ol class="relative font-mono text-[0.78rem]">
            <span data-scan class="absolute inset-x-0 top-0 h-8 rounded-lg bg-accent" aria-hidden="true"></span>
            {
              changedFiles.map((file, index) => (
                <li
                  data-diff-row={file === decisionFile ? 'decision' : ''}
                  class:list={[
                    'relative flex h-8 items-center gap-3 rounded-lg px-3',
                    file === decisionFile && 'text-foreground',
                  ]}
                >
                  <span class="w-5 text-right text-muted-foreground/60">{filesAbove + index + 1}</span>
                  <span class="truncate">{file}</span>
                  {file === decisionFile && (
                    <span
                      data-matters
                      class="ml-auto shrink-0 rounded-full bg-graph-4/15 px-2 py-0.5 font-sans text-[0.7rem] font-medium text-graph-4"
                    >
                      The decision
                    </span>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <div class="mt-24 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-3">
        {
          problems.map((problem, index) => (
            <div data-reveal class="bg-background p-8 lg:p-10">
              <span class="font-mono text-xs text-muted-foreground">0{index + 1}</span>
              <h3 class="mt-6 text-xl font-semibold tracking-[-0.03em]">{problem.title}</h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">{problem.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Beside the agent -->
    <section class="mx-auto max-w-[1440px] px-5 pt-32 lg:px-10 lg:pt-44">
      <div class="max-w-3xl">
        <p data-reveal class="font-mono text-xs tracking-[0.18em] text-muted-foreground uppercase">How it fits</p>
        <h2 data-reveal class="mt-5 text-[clamp(2.4rem,4.6vw,4.5rem)] leading-[0.98] font-semibold tracking-[-0.05em]">
          It sits beside your agent.{' '}
          <span class="text-muted-foreground">It does not replace it.</span>
        </h2>
        <p data-reveal class="mt-7 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Keep the agent in the terminal, desktop app or editor you already like. It publishes a walkthrough to Porcelain
          over MCP. You read it, reply on the code, and the agent reads your reply where it is working.
        </p>
      </div>

      <div data-reveal class="mt-16 grid grid-cols-1 items-center gap-6 lg:grid-cols-[1fr_minmax(6rem,1fr)_1.15fr_minmax(6rem,1fr)_1fr] lg:gap-0">
        <div class="rounded-2xl border border-border bg-card p-6">
          <div class="flex size-10 items-center justify-center rounded-xl bg-muted font-mono text-sm">&gt;_</div>
          <p class="mt-5 font-semibold tracking-[-0.02em]">Your agent</p>
          <p class="mt-1 text-sm text-muted-foreground">In the app you already run it in.</p>
        </div>
        <div class="relative hidden h-20 lg:block" aria-hidden="true">
          <div class="absolute inset-x-3 top-[34%] h-px bg-border"></div>
          <div class="absolute inset-x-3 top-[66%] h-px bg-border"></div>
          <span data-packet="right" class="absolute top-[34%] right-5 left-3 h-0"><span class="absolute left-0 size-2 -translate-y-1/2 rounded-full bg-graph-1 shadow-[0_0_12px_var(--graph-1)]"></span></span>
          <span data-packet="left" class="absolute top-[66%] right-5 left-3 h-0"><span class="absolute left-0 size-2 -translate-y-1/2 rounded-full bg-graph-2 shadow-[0_0_12px_var(--graph-2)]"></span></span>
          <span class="absolute top-0 left-1/2 -translate-x-1/2 font-mono text-[0.68rem] text-muted-foreground">walkthrough</span>
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 font-mono text-[0.68rem] text-muted-foreground">reply</span>
        </div>
        <div class="relative rounded-2xl bg-foreground p-7 text-background shadow-[0_30px_80px_-30px_rgb(0_0_0/0.5)]">
          <span class="absolute top-6 right-6 rounded-full border border-background/20 px-2 py-0.5 font-mono text-[0.68rem] text-background/70">MCP</span>
          <img src="/apple-touch-icon.png" alt="" width="40" height="40" class="size-10 rounded-xl" />
          <p class="mt-5 text-lg font-semibold tracking-[-0.02em]">Porcelain</p>
          <p class="mt-1 text-sm text-background/65">On the machine that holds the repository.</p>
        </div>
        <div class="relative hidden h-20 lg:block" aria-hidden="true">
          <div class="absolute inset-x-3 top-[34%] h-px bg-border"></div>
          <div class="absolute inset-x-3 top-[66%] h-px bg-border"></div>
          <span data-packet="right" class="absolute top-[34%] right-5 left-3 h-0"><span class="absolute left-0 size-2 -translate-y-1/2 rounded-full bg-graph-1 shadow-[0_0_12px_var(--graph-1)]"></span></span>
          <span data-packet="left" class="absolute top-[66%] right-5 left-3 h-0"><span class="absolute left-0 size-2 -translate-y-1/2 rounded-full bg-graph-2 shadow-[0_0_12px_var(--graph-2)]"></span></span>
          <span class="absolute top-0 left-1/2 -translate-x-1/2 font-mono text-[0.68rem] text-muted-foreground">review</span>
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 font-mono text-[0.68rem] text-muted-foreground">comment</span>
        </div>
        <div class="rounded-2xl border border-border bg-card p-6">
          <div class="flex size-10 items-center justify-center rounded-xl bg-muted">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <p class="mt-5 font-semibold tracking-[-0.02em]">You</p>
          <p class="mt-1 text-sm text-muted-foreground">In a browser, the Mac app, and soon your phone.</p>
        </div>
      </div>
    </section>

    <!-- The tour -->
    <section class="mx-auto max-w-[1440px] px-5 pt-32 lg:px-10 lg:pt-44">
      <div class="max-w-3xl">
        <p data-reveal class="font-mono text-xs tracking-[0.18em] text-muted-foreground uppercase">The walkthrough</p>
        <h2 data-reveal class="mt-5 text-[clamp(2.4rem,4.6vw,4.5rem)] leading-[0.98] font-semibold tracking-[-0.05em]">
          A review that reads in order.
        </h2>
        <p data-reveal class="mt-7 max-w-xl text-lg leading-relaxed text-muted-foreground">
          The agent explains the change one decision at a time, the way it would if it sat next to you. Scroll through
          one.
        </p>
      </div>

      <div data-tour class="relative mt-16 grid grid-cols-1 gap-10 lg:mt-8 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-20">
        <ol class="relative">
          <span class="absolute top-0 bottom-0 left-[0.9375rem] hidden w-px bg-border lg:block" aria-hidden="true">
            <span data-tour-progress class="absolute inset-x-0 top-0 h-full origin-top bg-foreground"></span>
          </span>
          {
            stops.map((stop, index) => (
              <li
                id={stop.id}
                data-stop={index}
                class="relative flex scroll-mt-24 flex-col justify-center gap-5 py-6 lg:min-h-[78svh] lg:py-0"
              >
                <div data-stop-copy class="flex gap-5 transition-opacity duration-500 lg:opacity-30">
                  <span class="relative z-10 inline-flex size-[1.875rem] shrink-0 items-center justify-center rounded-full bg-background text-xs font-semibold shadow-[inset_0_0_0_1px_var(--border)]">
                    {index + 1}
                  </span>
                  <div>
                    <h3 class="text-2xl font-semibold tracking-[-0.035em]">{stop.title}</h3>
                    <p class="mt-3 leading-relaxed text-muted-foreground">{stop.body}</p>
                  </div>
                </div>
                <div
                  class="relative overflow-hidden rounded-xl bg-card shadow-[0_0_0_1px_var(--border)] lg:hidden"
                  style={crop(stop.shot, stop.region).frame}
                >
                  <img
                    class="absolute block max-w-none"
                    style={crop(stop.shot, stop.region).image}
                    src={shots[stop.shot].image.src}
                    width={shots[stop.shot].image.width}
                    height={shots[stop.shot].image.height}
                    alt={shots[stop.shot].alt}
                    loading="lazy"
                  />
                </div>
              </li>
            ))
          }
        </ol>

        <div class="hidden lg:block">
          <div class="sticky top-0 flex h-svh items-center pt-16">
            <div class="w-full">
            <div class="rounded-[1.4rem] bg-muted/80 p-2 shadow-[inset_0_0_0_1px_var(--border),0_40px_120px_-50px_rgb(0_0_0/0.35)]">
              <div class="relative aspect-[1.44] overflow-hidden rounded-2xl bg-card shadow-[0_0_0_1px_var(--border)]">
                {
                  shots.map((shot, index) => (
                    <div data-camera={index} class="absolute inset-0 origin-top-left" style={index === 0 ? '' : 'opacity: 0'}>
                      <img
                        class="block size-full"
                        src={shot.image.src}
                        width={shot.image.width}
                        height={shot.image.height}
                        alt={shot.alt}
                        loading="lazy"
                      />
                    </div>
                  ))
                }
                <div
                  data-spotlight
                  class="pointer-events-none absolute rounded-xl opacity-0 shadow-[0_0_0_2px_var(--graph-1),0_0_0_9999px_rgb(10_10_10/0.14)]"
                  aria-hidden="true"
                >
                </div>
                <span
                  data-spotlight-label
