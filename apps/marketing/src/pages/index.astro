---
import Site from '../layouts/site.astro';
import walkthrough from '../../../../docs/readme/walkthrough.png';
import comments from '../../../../docs/readme/comments.png';
import proof from '../../../../docs/readme/proof.png';

const description =
  'A companion for the coding agents you already run. They publish a walkthrough of what changed. You read it, comment, and decide what to keep.';

const sections = [
  ['walkthrough', 'Walkthrough'],
  ['comments', 'Comments'],
  ['proof', 'Proof'],
  ['files', 'Files'],
  ['history', 'History'],
  ['remote', 'Remote'],
];
---

<Site description={description} sections={sections}>
    <main id="top" class="mx-auto w-full max-w-[1440px] px-5 pb-16 lg:px-10">
      <section class="pt-8 lg:pt-12">
        <ul class="relative h-24 sm:h-32" aria-label="Claude, Codex and Grok">
          <li
            class="animate-drift absolute top-1 left-0 motion-reduce:animate-none"
            style="--mark-rotate: -8deg; --mark-lift: -8px; animation-duration: 9.5s; animation-delay: -1.2s"
          >
            <span
              class="grid size-14 place-items-center rounded-2xl bg-card shadow-[0_16px_36px_-22px_rgba(0,0,0,0.55),inset_0_0_0_1px_var(--border)] sm:size-16"
            >
              <img class="size-7 sm:size-8" src="/agents/claude.svg" alt="" />
            </span>
          </li>
          <li
            class="animate-drift absolute top-7 left-[38%] motion-reduce:animate-none sm:top-10 sm:left-[42%]"
            style="--mark-rotate: 6deg; --mark-lift: -12px; animation-duration: 11s; animation-delay: -4s"
          >
            <span
              class="grid size-12 place-items-center rounded-2xl bg-card shadow-[0_16px_36px_-22px_rgba(0,0,0,0.55),inset_0_0_0_1px_var(--border)] sm:size-[4.5rem]"
            >
              <img class="agent-mark-light col-start-1 row-start-1 size-6 sm:size-7" src="/agents/codex-light.svg" alt="" />
              <img class="agent-mark-dark col-start-1 row-start-1 size-6 sm:size-7" src="/agents/codex-dark.svg" alt="" />
            </span>
          </li>
          <li
            class="animate-drift absolute top-0 right-0 motion-reduce:animate-none"
            style="--mark-rotate: -4deg; --mark-lift: -9px; animation-duration: 8.2s; animation-delay: -2.4s"
          >
            <span
              class="grid size-14 place-items-center rounded-2xl bg-card shadow-[0_16px_36px_-22px_rgba(0,0,0,0.55),inset_0_0_0_1px_var(--border)] sm:size-16"
            >
              <img class="agent-mark-light size-7 sm:size-8" src="/agents/grok-light.svg" alt="" />
              <img class="agent-mark-dark size-7 sm:size-8" src="/agents/grok-dark.svg" alt="" />
            </span>
          </li>
        </ul>
        <div class="grid items-end gap-8 pt-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:pt-8">
          <h1
            class="animate-in slide-in-from-bottom-6 fill-mode-both text-[clamp(2.85rem,4.35vw,4.35rem)] leading-[0.96] font-medium tracking-[-0.045em] duration-700"
          >
            Agents write the code.<br />This is where you read it.
          </h1>
          <div class="animate-in slide-in-from-bottom-6 fill-mode-both delay-150 max-w-md duration-700 lg:pb-2">
            <p class="text-lg leading-snug text-muted-foreground">
              Agents keep running in your preferred place. Porcelain is where they publish a walkthrough of the
              change, and where you comment back before you keep it.
            </p>
            <p class="mt-4 text-sm leading-snug text-muted-foreground">
              Browser and Mac, on Apple silicon. Mobile app coming soon.
            </p>
          </div>
        </div>
      </section>

      <figure id="walkthrough" class="animate-in slide-in-from-bottom-3 fill-mode-both delay-200 mt-12 scroll-mt-24 duration-700 lg:mt-16">
        <button
          type="button"
          class="block w-full cursor-zoom-in overflow-hidden rounded-xl bg-card text-left shadow-[inset_0_0_0_1px_var(--border)]"
          data-shot={walkthrough.src}
          data-alt="A decision in a published review, with its route through the code and a diff"
        >
          <img
            class="block w-full"
            src={walkthrough.src}
            width={walkthrough.width}
            height={walkthrough.height}
            alt="A decision in a published review, with its route through the code and a diff"
          />
        </button>
        <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-2 text-sm text-muted-foreground">
          <span>A decision, the route through the code, and the diff.</span>
          <span>Click a picture to see it larger.</span>
        </figcaption>
      </figure>

      <section class="mt-14 grid gap-10 border-t border-border pt-10 md:grid-cols-3 lg:mt-16" aria-label="The walkthrough">
        <div data-reveal>
          <h2 class="text-xl leading-tight font-medium tracking-[-0.03em]">One stop for each decision</h2>
          <p class="mt-3 text-muted-foreground">
            The agent publishes a briefing, then a stop for the decision. Numbered notes lead you to the files that
            matter, and the diff sits in the same view.
          </p>
        </div>
        <div data-reveal>
          <h2 class="text-xl leading-tight font-medium tracking-[-0.03em]">Not explained</h2>
          <p class="mt-3 text-muted-foreground">
            Changes the agent left out of the story stay visible. That stop links back to decisions that still contain
            those lines.
          </p>
        </div>
        <div data-reveal>
          <h2 class="text-xl leading-tight font-medium tracking-[-0.03em]">Reviewed</h2>
          <p class="mt-3 text-muted-foreground">
            Mark a file when you have read it. The review keeps track of what is left, so a long change does not become
            a pile of diffs.
          </p>
        </div>
      </section>

      <section id="comments" class="mt-28 scroll-mt-24 lg:mt-36">
        <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]" data-reveal>
          <h2 class="max-w-[14ch] text-[clamp(2rem,3.2vw,3.25rem)] leading-[1.02] font-medium tracking-[-0.04em]">
            Comment back before you keep it.
          </h2>
          <p class="max-w-xl text-lg leading-snug text-muted-foreground lg:pb-1">
            You write on the file. The agent replies in the same thread, over MCP, on your machine. The conversation
            stays with this change.
          </p>
        </div>
        <figure class="mt-8" data-reveal>
          <button
            type="button"
            class="block w-full cursor-zoom-in overflow-hidden rounded-xl bg-card text-left shadow-[inset_0_0_0_1px_var(--border)]"
            data-shot={comments.src}
            data-alt="A reviewer asks about the sample decision and the agent replies in the same thread"
          >
            <img
              class="block w-full"
              src={comments.src}
              width={comments.width}
              height={comments.height}
              alt="A reviewer asks about the sample decision and the agent replies in the same thread"
            />
          </button>
          <figcaption class="mt-3 text-sm text-muted-foreground">
            A file comment and a reply in the sample review.
          </figcaption>
        </figure>
      </section>

      <section id="proof" class="mt-28 scroll-mt-24 lg:mt-36">
        <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]" data-reveal>
          <h2 class="max-w-[14ch] text-[clamp(2rem,3.2vw,3.25rem)] leading-[1.02] font-medium tracking-[-0.04em]">
            See what was checked.
          </h2>
          <p class="max-w-xl text-lg leading-snug text-muted-foreground lg:pb-1">
            Readiness keeps the review in one place: files you have read, unexplained changes, comments, and checks.
            Proof opens the checks and the images the agent attached.
          </p>
        </div>
        <figure class="mt-8" data-reveal>
          <button
            type="button"
            class="block w-full cursor-zoom-in overflow-hidden rounded-xl bg-card text-left shadow-[inset_0_0_0_1px_var(--border)]"
            data-shot={proof.src}
            data-alt="Proof shows illustrative passing and failing checks, an image attachment and the readiness panel"
          >
            <img
              class="block w-full"
              src={proof.src}
              width={proof.width}
              height={proof.height}
              alt="Proof shows illustrative passing and failing checks, an image attachment and the readiness panel"
            />
          </button>
          <figcaption class="mt-3 text-sm text-muted-foreground">
            These sample results are not checks run on Porcelain itself.
          </figcaption>
        </figure>
      </section>

      <section class="mt-28 border-t border-border lg:mt-36" aria-label="More of the review">
        <div id="files" class="grid scroll-mt-24 gap-4 border-b border-border py-10 lg:grid-cols-[18rem_minmax(0,40rem)] lg:gap-16 lg:py-14" data-reveal>
          <h2 class="text-2xl leading-tight font-medium tracking-[-0.03em]">Pin what you are reading.</h2>
          <p class="text-lg leading-snug text-muted-foreground">
            Right-click a file and choose Pin file. It stays at the top of the tree until you choose Unpin file. Hide
            file, or Hide folder, takes it out of the list. The eye beside search shows what you hid.
          </p>
        </div>
        <div id="history" class="grid scroll-mt-24 gap-4 border-b border-border py-10 lg:grid-cols-[18rem_minmax(0,40rem)] lg:gap-16 lg:py-14" data-reveal>
          <h2 class="text-2xl leading-tight font-medium tracking-[-0.03em]">The commits, drawn as lanes.</h2>
          <p class="text-lg leading-snug text-muted-foreground">
            History is the repository's commit graph. Each commit sits on a lane, and a merge is drawn where branches
            meet, so you can see how the work arrived.
          </p>
        </div>
        <div id="remote" class="grid scroll-mt-24 gap-4 py-10 lg:grid-cols-[18rem_minmax(0,40rem)] lg:gap-16 lg:py-14" data-reveal>
          <h2 class="text-2xl leading-tight font-medium tracking-[-0.03em]">The repository stays where it is.</h2>
          <p class="text-lg leading-snug text-muted-foreground">
            On the computer that holds the repository, run porcelain pair and paste the link it prints. The browser or
            the Mac app keeps its own credential for that computer. The files are not copied across.
          </p>
        </div>
      </section>
    </main>

    <dialog
      id="shot"
      class="h-svh w-svw max-h-none max-w-none border-0 bg-transparent p-4 backdrop:bg-black/70 sm:p-8"
      aria-label="Screenshot"
    >
      <div class="flex h-full items-center justify-center">
        <button
          type="button"
          class="absolute top-4 right-4 z-10 rounded-full bg-foreground px-3 py-1.5 text-sm text-background"
        >
          Close
        </button>
        <img id="shot-image" class="max-h-full max-w-full rounded-lg" alt="" />
      </div>
    </dialog>

    <script>
      const dialog = document.querySelector('#shot');
      const shotImage = document.querySelector('#shot-image');
      const motion = ['animate-in', 'zoom-in-95', 'duration-300', 'fill-mode-both'];
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (dialog instanceof HTMLDialogElement && shotImage instanceof HTMLImageElement) {
        const open = (src: string, alt: string) => {
          shotImage.src = src;
          shotImage.alt = alt;
          shotImage.classList.remove(...motion);
          dialog.showModal();
          if (reduced()) return;
          void shotImage.offsetWidth;
          shotImage.classList.add(...motion);
        };

        for (const button of document.querySelectorAll('[data-shot]')) {
          if (!(button instanceof HTMLButtonElement)) continue;
          button.addEventListener('click', () => {
            const src = button.dataset.shot;
            const alt = button.dataset.alt;
            if (src && alt) open(src, alt);
          });
        }

        dialog.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('img')) return;
          dialog.close();
        });

        dialog.addEventListener('close', () => {
          shotImage.classList.remove(...motion);
        });
      }

      const revealed = document.querySelectorAll('[data-reveal]');
      if (!reduced() && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('animate-in', 'slide-in-from-bottom-6', 'duration-700', 'fill-mode-both');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.2 },
        );
        for (const node of revealed) observer.observe(node);
      }
    </script>
</Site>
