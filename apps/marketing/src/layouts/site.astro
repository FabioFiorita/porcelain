---
import '../styles/global.css';
import icon from '../../../../apps/web/public/icon-512.png';

interface Props {
  title?: string;
  description: string;
  sections?: readonly (readonly [string, string])[];
}

const { title = 'Porcelain', description, sections = [] } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const footer = [
  ['/install', 'Install'],
  ['/privacy', 'Privacy'],
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-svh flex-col bg-background font-sans text-base leading-normal tracking-[-0.011em] text-foreground antialiased">
    <header class="sticky top-0 z-20 border-b border-border/70 bg-background/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-5 py-3 lg:px-10">
        <a class="inline-flex items-center gap-2 text-lg font-medium tracking-[-0.03em] text-foreground no-underline" href="/">
          <img src={icon.src} width={icon.width} height={icon.height} alt="" class="size-7" />
          Porcelain
        </a>
        {
          sections.length > 0 && (
            <nav class="hidden items-center gap-5 text-sm text-muted-foreground xl:flex" aria-label="On this page">
              {sections.map(([id, label]) => (
                <a class="no-underline hover:text-foreground" href={`#${id}`}>
                  {label}
                </a>
              ))}
            </nav>
          )
        }
        <div class="flex items-center gap-1 sm:gap-2">
          <a
            class="inline-flex h-9 items-center gap-2 rounded-full px-2.5 text-sm whitespace-nowrap text-muted-foreground no-underline hover:bg-accent hover:text-foreground sm:px-3"
            href="https://github.com/FabioFiorita/porcelain"
          >
            <svg viewBox="0 0 1024 1024" class="size-4" aria-hidden="true">
              <path
                fill="currentColor"
                fill-rule="evenodd"
                d="M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-128.64 23.68-161.92-31.36-172.16-60.16-5.76-14.72-30.72-60.16-52.48-72.32-17.92-9.6-43.52-33.28-.64-33.92 40.32-.64 69.12 37.12 78.72 52.48 46.08 77.44 119.68 55.68 149.12 42.24 4.48-33.28 17.92-55.68 32.64-68.48-113.92-12.8-232.96-56.96-232.96-252.8 0-55.68 19.84-101.76 52.48-137.6-5.12-12.8-23.04-65.28 5.12-135.68 0 0 42.88-13.44 140.8 52.48 40.96-11.52 84.48-17.28 128-17.28s87.04 5.76 128 17.28c97.92-66.56 140.8-52.48 140.8-52.48 28.16 70.4 10.24 122.88 5.12 135.68 32.64 35.84 52.48 81.28 52.48 137.6 0 196.48-119.68 240-233.6 252.8 18.56 16 34.56 46.72 34.56 94.72 0 68.48-.64 123.52-.64 140.8 0 13.44 9.6 29.44 35.2 24.32C877.44 929.92 1024 737.92 1024 512 1024 229.12 794.88 0 512 0"
                clip-rule="evenodd"></path>
            </svg>
            Source
          </a>
          <a
            class="inline-flex h-9 items-center gap-2 rounded-full bg-foreground px-3 text-sm whitespace-nowrap text-background no-underline sm:px-3.5"
            href="/install"
          >
            <svg viewBox="0 0 814 1000" class="size-4" aria-hidden="true">
              <path
                fill="currentColor"
                d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
              ></path>
            </svg>
            Download for Mac
          </a>
        </div>
      </div>
      {
        sections.length > 0 && (
          <nav
            class="mx-auto flex max-w-[1440px] gap-4 overflow-x-auto px-5 pb-3 text-sm text-muted-foreground xl:hidden"
            aria-label="On this page"
          >
            {sections.map(([id, label]) => (
              <a class="shrink-0 no-underline hover:text-foreground" href={`#${id}`}>
                {label}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <slot />

    <footer class="mt-auto border-t border-border">
      <div class="mx-auto flex max-w-[1440px] flex-col gap-3 px-5 py-8 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between lg:px-10">
        <a class="inline-flex items-center gap-2 text-foreground no-underline" href="/">
          <img src={icon.src} width={icon.width} height={icon.height} alt="" class="size-5" />
          Porcelain
        </a>
        <nav class="flex items-center gap-5" aria-label="Footer">
          {
            footer.map(([href, label]) => (
              <a
                class="no-underline hover:text-foreground"
                href={href}
                aria-current={here === href ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
          <a class="no-underline hover:text-foreground" href="https://github.com/FabioFiorita/porcelain">Source</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
