#!/bin/sh
# Tracked pre-commit hook — the client-independent AGENTS.md rule-3 gate before
# ANY commit. Claude Code and Grok Build also run the shared PreToolUse guard
# through .claude/settings.json; Codex and plain terminals arrive here directly.
# Activated per clone by `core.hooksPath=.husky/_`, which `pnpm install` wires
# through the `prepare` script (husky). Husky owns the wiring only — the hook
# body is tracked here and is what every client actually runs.
#
# Commits are allowed on `main` (solo main-first flow), on managed `work/*`
# branches, and in harness-native worktrees; any other branch is unmanaged and
# rejected. Like git-guard.sh this fails CLOSED: if it can't run the gate, it
# refuses the commit rather than waving it through.
#
# Husky's shim runs this with `sh -e`, so an unguarded non-zero command aborts
# the hook (and blocks the commit). That is the direction we want to fail, but
# it means every intentional failure below stays inside `if`/`||` — do not add a
# bare test at the top level expecting it to just fall through.

set -u
# Hooks run without the interactive shell's PATH; make pnpm/node resolvable.
export PATH="$HOME/Library/pnpm:$HOME/.volta/bin:$HOME/.local/share/pnpm:/opt/homebrew/bin:/usr/local/bin:$PATH"

# AI harnesses (T3 Code, Codex, Grok Build, Claude) cut their own worktrees on
# their own branch names — often a detached HEAD — and can't be redirected into
# our managed lifecycle. Recognize them by location: a linked worktree (`.git`
# is a file, not a directory) below a known harness root.
is_harness_worktree() {
  harness_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$harness_root" ] && [ -f "$harness_root/.git" ] || return 1
  harness_root="$(CDPATH= cd -- "$harness_root" 2>/dev/null && pwd -P)" || return 1
  case "$harness_root" in
    "$HOME"/.t3/worktrees/* | "$HOME"/.codex/worktrees/* | "$HOME"/.grok/worktrees/* | */.claude/worktrees/*) return 0 ;;
    *) return 1 ;;
  esac
}

branch="$(git branch --show-current 2>/dev/null || true)"
case "$branch" in
  main) ;;
  work/*)
    profile_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if ! node -e '
      const fs = require("node:fs");
      const branch = process.argv[1];
      try {
        const c = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
        const ok = c.version === 1 && c.branch === branch &&
          branch === `work/${c.slug}` && Number.isInteger(c.port) &&
          c.port >= 43200 && c.port <= 43999;
        process.exit(ok ? 0 : 1);
      } catch { process.exit(1); }
    ' "$branch" "$profile_root/.porcelain-worktree.json"; then
      echo "pre-commit: $branch is missing a valid managed worktree profile." >&2
      exit 1
    fi
    ;;
  *)
    # Harness worktrees commit on any branch (or detached HEAD) — gate unchanged.
    if ! is_harness_worktree; then
      echo "pre-commit: unmanaged branch '$branch'; commit on main, use 'pnpm worktree create <slug>', or work in a harness worktree." >&2
      exit 1
    fi
    ;;
esac

# Claude Code already ran `pnpm verify` in its guaranteed PreToolUse guard.
# Grok does NOT skip here: its session id cannot prove this checkout's project
# hook was trusted, discovered, and successful, so the tracked gate stays authoritative.
# `release:cut` also refuses the skip: it commits through `pnpm version`'s nested
# git call, which the outer PreToolUse guard never saw, so this gate must run.
if [ -n "${CLAUDECODE:-}" ] && [ "${PORCELAIN_RELEASE_CUT:-}" != "1" ]; then
  echo "pre-commit: verify skipped: already gated by git-guard (CLAUDECODE set)."
  exit 0
fi

if [ "${PORCELAIN_SKIP_VERIFY:-}" = "1" ]; then
  echo "pre-commit: verify skipped: PORCELAIN_SKIP_VERIFY=1 (escape hatch)."
  exit 0
fi

# Git exports repository-local variables to hooks. Clear them before the test
# suite creates fixture repositories, or their nested git commands ignore cwd
# and mutate the worktree being committed.
git_local_env="$(git rev-parse --local-env-vars)"
for git_local_var in $git_local_env; do
  unset "$git_local_var"
done

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm not found on PATH — REFUSING the commit (the rule-3 gate can't run)." >&2
  echo "Fix PATH / install pnpm, or set PORCELAIN_SKIP_VERIFY=1 if you know the gate already passed." >&2
  exit 1
fi

out="$(mktemp)"
if pnpm verify >"$out" 2>&1; then
  rm -f "$out"
  exit 0
fi

{
  echo "Verification gate FAILED — commit blocked (AGENTS.md rule 3: lint · typecheck · test · build)."
  echo "Fix the failures, then retry the commit. For lint/format issues run: pnpm lint:fix"
  echo "----- last 40 lines of 'pnpm verify' -----"
  tail -n 40 "$out"
} >&2
rm -f "$out"
exit 1
