{
  "plugins": [
    "typescript"
  ],
  "jsPlugins": [
    "./architecture/oxlint-plugin.mjs",
    "@shadcn/lint"
  ],
  "options": {
    "typeAware": true
  },
  "rules": {
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
    "shadcn/no-raw-colors": "error",
    "porcelain/no-comments": "error",
    "porcelain/models-are-types": "error",
    "porcelain/bootstrap-constructs-only": "error",
    "porcelain/no-null-in-domain": "error",
    "porcelain/use-case-imports": "error",
    "porcelain/no-schema-parse-in-typed-code": "error",
    "porcelain/operation-class-shape": "error",
    "porcelain/feature-route-shape": "error",
    "porcelain/spec-no-mocking": "error",
    "porcelain/spec-no-skips": "error",
    "porcelain/spec-one-case-per-behaviour": "error",
    "porcelain/spec-behaviour-names": "error",
    "porcelain/spec-asserts": "error",
    "porcelain/spec-imports": "error",
    "porcelain/operation-class-members": "error",
    "porcelain/feature-route-registrations": "error",
    "porcelain/feature-route-handler": "error",
    "porcelain/mcp-tool-handler": "error",
    "porcelain/no-schema-parse-aliases": "error",
    "porcelain/no-loose-equality-in-domain": "error",
    "porcelain/no-node-globals": "error",
    "porcelain/no-disable-directives": "error",
    "porcelain/no-void-statement": "error",
    "porcelain/adapters-never-import-services": "error",
    "porcelain/rules-are-pure": "error",
    "porcelain/static-imports": "error",
    "porcelain/kernel-is-types": "error",
    "porcelain/models-file-shape": "error",
    "porcelain/no-inline-execute-types": "error",
    "porcelain/one-clock": "error",
    "porcelain/no-undefined-union-result": "error",
    "porcelain/signals-are-passed": "error",
    "porcelain/imports-by-path": "error",
    "porcelain/port-shape": "error",
    "porcelain/no-exported-constants": "error",
    "porcelain/no-number-outside-limits": "error",
    "porcelain/naming": "error",
    "porcelain/implementation-name": "error",
    "porcelain/bootstrap-starts-nothing": "error",
    "porcelain/fakes-store": "error",
    "porcelain/scope-shape": "error",
    "porcelain/no-interface-in-runtime": "error",
    "porcelain/timers-in-runtime": "error",
    "porcelain/fixture-imports": "error",
    "porcelain/events-after-lane": "error",
    "porcelain/limits-from-settings": "error",
    "porcelain/no-port-shaped-alias": "error",
    "porcelain/interfaces-hold-interfaces": "error",
    "porcelain/use-case-input-is-contract": "error",
    "porcelain/failure-in-service": "error",
    "porcelain/cross-domain-through-use-cases": "error",
    "porcelain/use-case-computes": "error",
    "porcelain/events-from-use-cases": "error",
    "porcelain/no-nested-lane": "error",
    "porcelain/lane-only-with-store": "error",
    "porcelain/lane-after-check": "error",
    "porcelain/interfaces-only-in-ports": "error",
    "porcelain/adapters-report-facts": "error",
    "porcelain/root-scripts-import-no-package": "error",
    "porcelain/web-no-use-state": "error",
    "porcelain/web-no-module-mutable-binding": "error",
    "porcelain/web-no-use-reducer": "error",
    "porcelain/web-no-context": "error",
    "porcelain/web-no-use-sync-external-store": "error",
    "porcelain/web-no-action-hooks": "error",
    "porcelain/web-no-manual-memo": "error",
    "porcelain/web-effects-in-adapters": "error",
    "porcelain/web-refs-in-adapters": "error",
    "porcelain/web-views-no-jsx-refs": "error",
    "porcelain/web-listeners-in-adapters": "error",
    "porcelain/web-store-owns-zustand": "error",
    "porcelain/web-store-owns-storage": "error",
    "porcelain/web-queries-own-reads": "error",
    "porcelain/web-queries-export-reads": "error",
    "porcelain/web-adapters-are-imperative-glue": "error",
    "porcelain/web-commands-own-writes": "error",
    "porcelain/web-cache-writes-in-commands": "error",
    "porcelain/web-overlays-own-handles": "error",
    "porcelain/web-views-no-controlled-open": "error",
    "porcelain/web-api-owns-request": "error",
    "porcelain/web-transport-owner": "error",
    "porcelain/web-timers-in-commands-and-store": "error",
    "porcelain/web-rules-are-pure": "error",
    "porcelain/web-views-no-await": "error",
    "porcelain/web-views-no-promise-chains": "error",
    "porcelain/web-views-no-try": "error",
    "porcelain/web-views-no-command-loops": "error",
    "porcelain/web-views-no-loops": "error",
    "porcelain/web-views-no-direct-data": "error",
    "porcelain/web-views-no-transport": "error",
    "porcelain/web-views-no-contracts": "error",
    "porcelain/web-view-line-budget": "error",
    "porcelain/web-no-empty-catch": "error",
    "porcelain/web-shadcn-wrapper": "error",
    "porcelain/web-browser-spec-no-mocks": "error",
    "porcelain/web-browser-spec-no-skips": "error",
    "porcelain/web-journey-imports": "error",
    "porcelain/web-journey-asserts": "error",
    "porcelain/web-journey-retrying-assertions": "error",
    "porcelain/web-journey-locators": "error",
    "porcelain/web-journey-no-waits": "error",
    "porcelain/web-journey-through-kit": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/consistent-type-imports": "error"
  },
  "overrides": [
    {
      "files": [
        "architecture/*.mjs",
        "architecture/*.cjs"
      ],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
