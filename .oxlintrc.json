{
  "plugins": ["typescript"],
  "jsPlugins": ["./architecture/oxlint-plugin.mjs", "@shadcn/lint"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^ResizableHandle$",
            "allow": ["layout", "bg-transparent"]
          },
          {
            "pattern": "^SidebarMenuSub$",
            "allow": ["layout", "me-0", "pe-0"]
          }
        ],
        "message": {
          "color": "\"{{className}}\" is not allowed on <{{component}}>, which owns its {{category}}. Use one of its variants, or compose the look in the feature view from layout classes on a parent; components/ui is never edited, so when no variant gives the look, ask the owner.",
          "typography": "\"{{className}}\" is not allowed on <{{component}}>, which owns its {{category}}. Use one of its variants, or compose the look in the feature view from layout classes on a parent; components/ui is never edited, so when no variant gives the look, ask the owner.",
          "shape": "\"{{className}}\" is not allowed on <{{component}}>, which owns its {{category}}. Use one of its variants, or compose the look in the feature view from layout classes on a parent; components/ui is never edited, so when no variant gives the look, ask the owner.",
          "effects": "\"{{className}}\" is not allowed on <{{component}}>, which owns its {{category}}. Use one of its variants, or compose the look in the feature view from layout classes on a parent; components/ui is never edited, so when no variant gives the look, ask the owner.",
          "motion": "\"{{className}}\" is not allowed on <{{component}}>, which owns its {{category}}. Use one of its variants, or compose the look in the feature view from layout classes on a parent; components/ui is never edited, so when no variant gives the look, ask the owner.",
          "spacing": "\"{{className}}\" is not allowed on <{{component}}>, which owns its spacing. Use one of its sizes, or gap and margin on a parent in the feature view; components/ui is never edited, so when no size fits, ask the owner."
        }
      }
    ],
    "shadcn/no-raw-colors": "error",
    "porcelain/mobile-native-ui": "error",
    "porcelain/mobile-system-chrome": "error",
    "porcelain/client-platform-through-ports": "error",
    "porcelain/client-owns-shared-logic": "error",
    "porcelain/worktree-admission-owner": "error",
    "porcelain/models-are-types": "error",
    "porcelain/bootstrap-constructs-only": "error",
    "porcelain/no-null-in-domain": "error",
    "porcelain/use-case-imports": "error",
    "porcelain/no-schema-parse-in-typed-code": "error",
    "porcelain/operation-class-shape": "error",
    "porcelain/spec-no-mocking": "error",
    "porcelain/spec-no-skips": "error",
    "porcelain/spec-one-case-per-behaviour": "error",
    "porcelain/spec-asserts": "error",
    "porcelain/spec-imports": "error",
    "porcelain/feature-route-registrations": "error",
    "porcelain/feature-route-handler": "error",
    "porcelain/mcp-tool-handler": "error",
    "porcelain/no-node-globals": "error",
    "porcelain/adapters-never-import-services": "error",
    "porcelain/rules-are-pure": "error",
    "porcelain/static-imports": "error",
    "porcelain/no-blocking-child-process": "error",
    "porcelain/one-clock": "error",
    "porcelain/imports-by-path": "error",
    "porcelain/fakes-store": "error",
    "porcelain/timers-in-runtime": "error",
    "porcelain/fixture-imports": "error",
    "porcelain/events-after-lane": "error",
    "porcelain/limits-from-settings": "error",
    "porcelain/use-case-input-is-contract": "error",
    "porcelain/failure-in-service": "error",
    "porcelain/cross-domain-through-use-cases": "error",
    "porcelain/use-case-computes": "error",
    "porcelain/events-from-use-cases": "error",
    "porcelain/no-nested-lane": "error",
    "porcelain/lane-only-with-store": "error",
    "porcelain/lane-after-check": "error",
    "porcelain/adapters-report-facts": "error",
    "porcelain/root-scripts-import-no-package": "error",
    "porcelain/typed-evaluation": "error",
    "porcelain/web-no-module-mutable-binding": "error",
    "porcelain/web-no-context": "error",
    "porcelain/web-no-action-hooks": "error",
    "porcelain/web-no-manual-memo": "error",
    "porcelain/web-store-owns-atoms": "error",
    "porcelain/web-store-owns-storage": "error",
    "porcelain/web-commands-own-writes": "error",
    "porcelain/web-overlays-own-handles": "error",
    "porcelain/web-api-owns-request": "error",
    "porcelain/web-transport-owner": "error",
