{
  "plugins": [
    "typescript"
  ],
  "jsPlugins": [
    "./architecture/oxlint-plugin.mjs"
  ],
  "options": {
    "typeAware": true
  },
  "rules": {
    "porcelain/no-comments": "error",
    "porcelain/models-are-types": "error",
    "porcelain/bootstrap-constructs-only": "error",
    "porcelain/no-null-in-domain": "error",
    "porcelain/controller-imports": "error",
    "porcelain/no-schema-parse-in-typed-code": "error",
    "porcelain/operation-class-shape": "error",
    "porcelain/feature-route-shape": "error",
    "porcelain/spec-no-mocking": "error",
    "porcelain/spec-no-skips": "error",
    "porcelain/spec-behaviour-names": "error",
    "porcelain/spec-imports": "error",
    "porcelain/operation-class-members": "error",
    "porcelain/feature-route-registrations": "error",
    "porcelain/feature-route-handler": "warn",
    "porcelain/no-schema-parse-aliases": "error",
    "porcelain/no-loose-equality-in-domain": "error",
    "porcelain/no-node-globals": "warn",
    "porcelain/no-disable-directives": "error",
    "porcelain/no-void-statement": "warn",
    "porcelain/adapters-never-import-services": "warn",
    "porcelain/write-needs-write-lane": "warn",
    "porcelain/rules-are-pure": "warn",
    "porcelain/kernel-is-types": "warn",
    "porcelain/models-file-shape": "warn",
    "porcelain/no-inline-execute-types": "warn",
    "porcelain/one-clock": "warn",
    "porcelain/no-undefined-union-result": "warn",
    "porcelain/signals-are-passed": "warn",
    "porcelain/imports-by-path": "warn",
    "porcelain/port-shape": "warn",
    "porcelain/no-exported-constants": "warn",
    "porcelain/naming": "warn",
    "porcelain/implementation-name": "warn",
    "porcelain/bootstrap-starts-nothing": "warn",
    "porcelain/fakes-store": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/consistent-type-imports": "error"
  },
  "overrides": [
    {
      "files": [
        "architecture/*.mjs",
        "architecture/*.cjs"
      ],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
