    "porcelain/web-views-no-transport": "error",
    "porcelain/web-views-no-contracts": "error",
    "porcelain/web-dialogs-from-ui": "error",
    "porcelain/web-keys-through-hotkeys": "error",
    "porcelain/web-navigation-through-router": "error",
    "porcelain/web-no-empty-catch": "error",
    "porcelain/web-shadcn-wrapper": "error",
    "porcelain/web-design-tokens": "error",
    "porcelain/web-browser-spec-no-mocks": "error",
    "porcelain/web-browser-spec-no-skips": "error",
    "porcelain/web-journey-imports": "error",
    "porcelain/web-journey-asserts": "error",
    "porcelain/web-journey-retrying-assertions": "error",
    "porcelain/web-journey-locators": "error",
    "porcelain/web-journey-no-waits": "error",
    "porcelain/web-journey-through-kit": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "porcelain/no-comments": "error",
    "porcelain/spec-behaviour-names": "error",
    "porcelain/naming": "error",
    "porcelain/interfaces-only-in-ports": "error",
    "porcelain/no-port-shaped-alias": "error",
    "eqeqeq": "error",
    "porcelain/spec-no-clock": "error",
    "porcelain/server-spec-no-waits": "error"
  },
  "overrides": [
    {
      "files": ["architecture/*.mjs", "architecture/*.cjs"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["apps/web/src/shared/workspace/copy.ts"],
      "rules": {
        "typescript/no-deprecated": "off"
      }
    }
  ]
}
