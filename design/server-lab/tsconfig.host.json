{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2024"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "host",
    "vite.config.ts",
    "../../apps/server/src/filesystem/node-opendir.d.ts"
  ]
}
