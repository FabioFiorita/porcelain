{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.ts"]
    },
    "apps/server": {
      "entry": ["src/cli/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    },
    "packages/git": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts"],
      "ignore": ["src/components/ui/**"],
      "ignoreDependencies": [
        "cmdk",
        "embla-carousel-react",
        "input-otp",
        "react-day-picker"
      ]
    },
    "packages/client": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["mkfifo"]
}
