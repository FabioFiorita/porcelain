{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.ts"]
    },
    "apps/server": {
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    },
    "packages/git": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts"],
      "ignore": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
      "ignoreDependencies": [
        "@shadcn/react",
        "cmdk",
        "embla-carousel-react",
        "input-otp",
        "react-day-picker",
        "react-resizable-panels",
        "recharts",
        "@tanstack/react-form",
        "@tanstack/markdown"
      ]
    }
  },
  "ignoreBinaries": ["mkfifo", "openssl"]
}
