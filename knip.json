{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.ts"]
    },
    "apps/server": {
      "entry": ["src/http/server.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["mkfifo"]
}
